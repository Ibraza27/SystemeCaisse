<Window x:Class="SystemeCaisse.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SystemeCaisse.UI"
        xmlns:views="clr-namespace:SystemeCaisse.UI.Views"
        mc:Ignorable="d"
        x:Name="mainWindow"
        Title="Hippocampe - Système de Caisse" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        UseLayoutRounding="True" 
        TextOptions.TextFormattingMode="Display"
        Icon="{Binding CurrentEntreprise.LogoPath, TargetNullValue=/Images/logo.png}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <!-- Right Sidebar Column for Caisse (Wider for better visibility) -->
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content (Tabs) -->
                <RowDefinition Height="Auto"/> <!-- Status Bar -->
            </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" Padding="15" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Logo -->
                    <ColumnDefinition Width="*"/>    <!-- Info -->
                    <ColumnDefinition Width="Auto"/> <!-- System Info -->
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <Image Grid.Column="0" Source="{Binding CurrentEntreprise.LogoPath, TargetNullValue=/Images/logo.png}" 
                       Width="80" Height="80" Margin="0,0,15,0" HorizontalAlignment="Right"/>

                <!-- Enterprise Info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentEntreprise.Nom}" FontSize="20" FontWeight="Bold" Foreground="#333"/>
                    <TextBlock Text="{Binding CurrentEntreprise.Adresse}" FontSize="12" Foreground="#666"/>
                    <TextBlock Text="{Binding CurrentEntreprise.Telephone}" FontSize="12" Foreground="#666"/>
                </StackPanel>

                <!-- System Info (Right Side) -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=mainTabs, Path=SelectedIndex}" Value="1">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Caisse N°1" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Right"/>
                    <TextBlock Text="Vendeur: Admin" Foreground="#666" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Navigation Tabs -->
        <!-- Navigation Tabs (Default to Caisse/Index 1) -->
        <TabControl x:Name="mainTabs" Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" SelectionChanged="TabControl_SelectionChanged" Background="Transparent" BorderThickness="0" Margin="10">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Padding" Value="15,10"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" BorderThickness="0,0,0,3" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter x:Name="ContentSite"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"
                                                      ContentSource="Header"
                                                      RecognizesAccessKey="True"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#2E7D32"/> <!-- Green accent -->
                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter Property="Foreground" Value="#777"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="📊 Tableau de Bord">
                <views:DashboardView DataContext="{Binding DashboardVM}"/>
            </TabItem>

            <TabItem Header="🛒 Caisse">
                <views:SalesView/>
            </TabItem>
            
            <TabItem Header="📦 Produits">
                <views:ProductsView DataContext="{Binding ProductsVM}"/>
            </TabItem>
            
            <TabItem Header="📊 Stocks">
                 <views:StocksView DataContext="{Binding StocksVM}"/>
            </TabItem>
            
            <TabItem Header="💰 Ventes">
                 <views:HistoryView DataContext="{Binding HistoryVM}"/>
            </TabItem>

            <TabItem Header="📈 Analyses">
                 <ContentControl>
                     <ContentControl.Style>
                         <Style TargetType="ContentControl">
                             <Setter Property="Content" Value="{x:Null}"/>
                             <Style.Triggers>
                                 <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=IsSelected}" Value="True">
                                     <Setter Property="Content">
                                         <Setter.Value>
                                             <views:AnalysisView DataContext="{Binding AnalysisVM}"/>
                                         </Setter.Value>
                                     </Setter>
                                 </DataTrigger>
                             </Style.Triggers>
                         </Style>
                     </ContentControl.Style>
                 </ContentControl>
            </TabItem>
            
            <TabItem Header="⚙️ Configuration">
                 <views:SettingsView DataContext="{Binding SettingsVM}"/>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#EEE" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="Green" FontWeight="SemiBold"/>
                    <TextBlock Text=" | " Foreground="#999" Margin="5,0"/>
                    <TextBlock Text="Alertes Stock : " Foreground="#666"/>
                    <TextBlock Text="{Binding StocksVM.NombreAlertes}" Foreground="Red" FontWeight="Bold"/>
                </StackPanel>
                
                <TextBlock Grid.Column="1" Text="v1.0.0" Foreground="#999">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=mainTabs, Path=SelectedIndex}" Value="1">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
        </Grid>

        <!-- Ticket Sidebar Panel (Visible only in Caisse tab) -->
        <Border Grid.Column="1" Background="White" Width="750" BorderBrush="#DDD" BorderThickness="1,0,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=mainTabs, Path=SelectedIndex}" Value="1">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ContentControl x:Name="TicketPlaceholder" />
        </Border>
    </Grid>
</Window>
