<Window x:Class="SystemeCaisse.UI.Views.AddPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter un Paiement" Width="550" Height="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="💰 Ajouter un Paiement" FontSize="18" FontWeight="Bold" Foreground="#7B1FA2" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1">
            <DockPanel Margin="0,0,0,15">
                <TextBlock Text="Restant à payer :" FontSize="14" Foreground="#666"/>
                <TextBlock x:Name="tbRestant" FontSize="18" FontWeight="Bold" Foreground="#C62828" HorizontalAlignment="Right"/>
            </DockPanel>

            <!-- Montant -->
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Montant :" FontSize="14" VerticalAlignment="Center"/>
                <TextBox x:Name="tbMontant" Grid.Column="1" FontSize="20" FontWeight="Bold" Padding="8,5" Margin="10,0,10,0"
                         VerticalContentAlignment="Center"/>
                <Button Grid.Column="2" Content="= Exact" Click="FillExact_Click" Padding="10,5" FontWeight="SemiBold"
                        Background="#F3E5F5" Foreground="#7B1FA2" BorderBrush="#7B1FA2" Cursor="Hand"/>
            </Grid>

            <!-- Mode de paiement -->
            <TextBlock Text="Mode de paiement :" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <UniformGrid Columns="5" Margin="0,0,0,5">
                <RadioButton x:Name="rbEspece" Content="💵 Espèce" GroupName="ModePaiement"
                             FontSize="11" FontWeight="SemiBold" Margin="0,0,3,0" Padding="3,3"/>
                <RadioButton x:Name="rbVirement" Content="🏦 Virement" GroupName="ModePaiement"
                             FontSize="11" FontWeight="SemiBold" Margin="3,0,3,0" Padding="3,3"/>
                <RadioButton x:Name="rbWero" Content="📱 Wero" GroupName="ModePaiement"
                             FontSize="11" FontWeight="SemiBold" Margin="3,0,3,0" Padding="3,3"/>
                <RadioButton x:Name="rbCB" Content="💳 CB" GroupName="ModePaiement"
                             FontSize="11" FontWeight="SemiBold" Margin="3,0,3,0" Padding="3,3"/>
                <RadioButton x:Name="rbEnLigne" Content="🌐 En ligne" GroupName="ModePaiement" IsChecked="True"
                             FontSize="11" FontWeight="SemiBold" Margin="3,0,0,0" Padding="3,3"/>
            </UniformGrid>
        </StackPanel>

        <UniformGrid Grid.Row="2" Columns="2" Margin="0,15,0,0">
            <Button Content="✅ Confirmer" Click="Confirm_Click" Height="40" Margin="0,0,5,0"
                    Background="#7B1FA2" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
            <Button Content="Annuler" Click="Cancel_Click" Height="40" Margin="5,0,0,0"
                    Background="#EEE" Foreground="#333" FontWeight="SemiBold" FontSize="14" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
        </UniformGrid>
    </Grid>
</Window>
