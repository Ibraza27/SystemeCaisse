<UserControl x:Class="SystemeCaisse.UI.Views.CommandesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1400">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProductCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#DDDDDD" BlurRadius="5" ShadowDepth="2" Direction="270" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#BBBBBB" BlurRadius="10" ShadowDepth="4" Direction="270" Opacity="0.7"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Background" Value="#FAFAFA"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- LIST MODE -->
        <Grid Visibility="{Binding IsListMode, Converter={StaticResource BoolToVis}}" Margin="10">

            <!-- Filters and List -->
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📋 Commandes" FontSize="22" FontWeight="Bold" Foreground="#333"/>
                        <Button Content="📊 Récap Produits" Command="{Binding PrintRecapCommand}" Margin="15,0,0,0"
                                Padding="12,6" Background="#E3F2FD" Foreground="#1565C0" FontWeight="SemiBold"
                                Style="{StaticResource BaseButtonStyle}" ToolTip="Récapitulatif des produits de la liste filtrée"/>
                    </StackPanel>
                    <Button Content="+ Nouvelle Commande" Command="{Binding NewCommandeCommand}"
                            HorizontalAlignment="Right" Padding="15,8"
                            Background="#2E7D32" Foreground="White" FontWeight="Bold" FontSize="14"
                            Style="{StaticResource BaseButtonStyle}"/>
                </Grid>

                <!-- Filters -->
                <Border Grid.Row="1" Background="White" Padding="10" Margin="0,0,0,10" CornerRadius="4" BorderBrush="#DDD" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="180" 
                                     VerticalContentAlignment="Center" Padding="5,3"/>

                            <TextBlock Text="Statut :" VerticalAlignment="Center" Margin="15,0,5,0" FontWeight="Bold"/>
                            <ComboBox SelectedValue="{Binding StatutFilter}" Width="100">
                                <sys:String>Tous</sys:String>
                                <sys:String>En attente</sys:String>
                                <sys:String>Traitée</sys:String>
                                <sys:String>Annulée</sys:String>
                            </ComboBox>

                            <TextBlock Text="Paiement :" VerticalAlignment="Center" Margin="10,0,5,0" FontWeight="Bold"/>
                            <ComboBox SelectedValue="{Binding PaiementFilter}" Width="100">
                                <sys:String>Tous</sys:String>
                                <sys:String>Réglé</sys:String>
                                <sys:String>Partiel</sys:String>
                                <sys:String>Non réglé</sys:String>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="📍 Ville/CP :" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold"/>
                            <TextBlock Text="{Binding VilleCPFilterDisplay}" VerticalAlignment="Center" Foreground="#1565C0" FontWeight="SemiBold" Margin="0,0,10,0" MaxWidth="250" TextTrimming="CharacterEllipsis"/>
                            <Button Content="📍 Sélectionner" Command="{Binding OpenVilleCPFilterCommand}" Padding="8,3"
                                    Background="#E3F2FD" Foreground="#1565C0" Style="{StaticResource BaseButtonStyle}" Margin="0,0,5,0"/>
                            <Button Content="🔄 Effacer filtres" Command="{Binding ClearAllFiltersCommand}" Padding="8,3"
                                    Background="#FFF3E0" Foreground="#E65100" Style="{StaticResource BaseButtonStyle}" Margin="0,0,5,0"/>
                            <Button Content="🔄" Command="{Binding LoadCommand}" Padding="8,3"
                                    Background="#EEE" Style="{StaticResource BaseButtonStyle}" ToolTip="Actualiser"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- DataGrid -->
                <DataGrid Grid.Row="2" ItemsSource="{Binding Commandes}" SelectedItem="{Binding SelectedCommande}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          Background="White" BorderBrush="#DDD" BorderThickness="1" 
                          GridLinesVisibility="Horizontal" RowHeight="38" HeadersVisibility="Column"
                          CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="N° Commande" Binding="{Binding NumeroCommande}" Width="150" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="100"/>
                        <DataGridTextColumn Header="Prénom" Binding="{Binding Prenom}" Width="100"/>
                        <DataGridTextColumn Header="Téléphone" Binding="{Binding Telephone}" Width="110"/>
                        <DataGridTextColumn Header="Ville / CP" Binding="{Binding VilleCodePostal}" Width="130"/>
                        <DataGridTextColumn Header="Articles" Binding="{Binding NbArticles}" Width="60"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalAvecLivraison, StringFormat=C}" Width="80" FontWeight="Bold"/>
                        <DataGridTemplateColumn Header="Restant" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Restant, StringFormat=C}" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#C62828"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatutPaiement}" Value="regle">
                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Statut" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatutDisplay}" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#F57F17"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Statut}" Value="traitee">
                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Statut}" Value="annulee">
                                                        <Setter Property="Foreground" Value="#C62828"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- NEW COMMANDE MODE (same layout as Caisse: SalesView + TicketView) -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsNewCommandeMode, Converter={StaticResource BoolToVis}}" Margin="10">

            <!-- Left: Product Catalog (exactly like SalesView) -->
            <Grid Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,10">
                    <TextBlock Text="📋 Nouvelle Commande" FontSize="22" FontWeight="Bold" Foreground="#1565C0"/>
                    <Button Content="◀ Retour à la liste" Command="{Binding CancelNewCommandeCommand}"
                            HorizontalAlignment="Right" Padding="12,6"
                            Background="#FFEBEE" Foreground="#C62828" FontWeight="Bold"
                            Style="{StaticResource BaseButtonStyle}"/>
                </Grid>

                <!-- Search Bar (exact copy from SalesView) -->
                <Border Grid.Row="1" Background="White" CornerRadius="20" Padding="15,5" Margin="0,0,0,20" BorderBrush="#EEEEEE" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" VerticalAlignment="Center" Margin="5,0,10,0" Foreground="Gray" FontSize="16"/>

                        <ComboBox x:Name="searchComboCmd" Grid.Column="1"
                                  IsEditable="True" IsTextSearchEnabled="False"
                                  IsTextSearchCaseSensitive="False" StaysOpenOnEdit="True"
                                  BorderThickness="0" VerticalAlignment="Center" FontSize="16"
                                  ItemsSource="{Binding SearchSuggestions}"
                                  Text="{Binding NewCommandeSearchText, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedItem="{Binding SelectedSearchProduct}"
                                  IsDropDownOpen="{Binding IsSearchDropDownOpen, Mode=TwoWay}"
                                  Loaded="searchComboCmd_Loaded"
                                  Foreground="#333">
                            <ComboBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ScanNewCommandeCommand}"/>
                            </ComboBox.InputBindings>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="550" Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="45"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Product Image -->
                                        <Border Width="40" Height="40" CornerRadius="4" Background="#F8F8F8" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding FullImagePath, Converter={StaticResource PathToImage}}" Stretch="Uniform" Margin="2"/>
                                                <TextBlock Text="📦" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#CCC"
                                                           Visibility="{Binding FullImagePath, Converter={StaticResource InvertedNullToVis}}"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Nom}" FontWeight="Bold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="8,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PrixVente, StringFormat={}{0:C}}" Foreground="#2E7D32" FontWeight="Bold"/>
                                            <TextBlock Foreground="#777" Margin="2,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="/Unité"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TypeVente}" Value="poids">
                                                                <Setter Property="Text" Value="/kg"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Grid.Column="2" Content="✕" Command="{Binding ClearNewCommandeSearchCommand}"
                                Background="Transparent" BorderThickness="0" Foreground="#999" FontSize="18" Padding="8" Cursor="Hand"
                                ToolTip="Effacer la recherche"/>
                    </Grid>
                </Border>

                <!-- Top Products (exact copy from SalesView with images) -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,10">
                            <TextBlock Text="Top Produits" FontSize="20" FontWeight="Bold" Foreground="#333"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding TopProducts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Left"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="160" Height="180" Margin="8" Style="{StaticResource ProductCardStyle}">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.AddToCommandePanierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <!-- Product Image (with fallback) -->
                                            <Border Grid.Row="0" Margin="5" CornerRadius="8" Background="#F8F8F8" ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding FullImagePath, Converter={StaticResource PathToImage}}" Stretch="Uniform" Margin="5"/>
                                                    <TextBlock Text="📦" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#CCCCCC"
                                                               Visibility="{Binding FullImagePath, Converter={StaticResource InvertedNullToVis}}"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Grid.Row="1" Text="{Binding Nom}" FontWeight="Bold" FontSize="13" 
                                                       Margin="5,5,5,0" HorizontalAlignment="Center" TextAlignment="Center"
                                                       TextWrapping="Wrap" MaxHeight="45" VerticalAlignment="Top" Foreground="#333333"/>
                                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,5">
                                                <TextBlock Text="{Binding PrixVente, StringFormat={}{0:C}}" FontSize="14" FontWeight="SemiBold" Foreground="#2E7D32"/>
                                                <TextBlock FontSize="11" Foreground="#777" VerticalAlignment="Bottom" Margin="2,0,0,1">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="/Unité"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TypeVente}" Value="poids">
                                                                    <Setter Property="Text" Value="/kg"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
