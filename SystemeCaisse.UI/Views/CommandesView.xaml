<UserControl x:Class="SystemeCaisse.UI.Views.CommandesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1400">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProductCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#DDDDDD" BlurRadius="5" ShadowDepth="2" Direction="270" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#BBBBBB" BlurRadius="10" ShadowDepth="4" Direction="270" Opacity="0.7"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Background" Value="#FAFAFA"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- LIST MODE -->
        <Grid Visibility="{Binding IsListMode, Converter={StaticResource BoolToVis}}" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="520"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Filters & List -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📋 Commandes" FontSize="22" FontWeight="Bold" Foreground="#333"/>
                        <Button Content="📊 Récap Produits" Command="{Binding PrintRecapCommand}" Margin="15,0,0,0"
                                Padding="12,6" Background="#E3F2FD" Foreground="#1565C0" FontWeight="SemiBold"
                                Style="{StaticResource BaseButtonStyle}" ToolTip="Récapitulatif des produits de la liste filtrée"/>
                    </StackPanel>
                    <Button Content="+ Nouvelle Commande" Command="{Binding NewCommandeCommand}"
                            HorizontalAlignment="Right" Padding="15,8"
                            Background="#2E7D32" Foreground="White" FontWeight="Bold" FontSize="14"
                            Style="{StaticResource BaseButtonStyle}"/>
                </Grid>

                <!-- Filters -->
                <Border Grid.Row="1" Background="White" Padding="10" Margin="0,0,0,10" CornerRadius="4" BorderBrush="#DDD" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="180" 
                                     VerticalContentAlignment="Center" Padding="5,3"/>

                            <TextBlock Text="Statut :" VerticalAlignment="Center" Margin="15,0,5,0" FontWeight="Bold"/>
                            <ComboBox SelectedValue="{Binding StatutFilter}" Width="100">
                                <sys:String>Tous</sys:String>
                                <sys:String>En attente</sys:String>
                                <sys:String>Traitée</sys:String>
                                <sys:String>Annulée</sys:String>
                            </ComboBox>

                            <TextBlock Text="Paiement :" VerticalAlignment="Center" Margin="10,0,5,0" FontWeight="Bold"/>
                            <ComboBox SelectedValue="{Binding PaiementFilter}" Width="100">
                                <sys:String>Tous</sys:String>
                                <sys:String>Réglé</sys:String>
                                <sys:String>Partiel</sys:String>
                                <sys:String>Non réglé</sys:String>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="📍 Ville/CP :" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold"/>
                            <TextBlock Text="{Binding VilleCPFilterDisplay}" VerticalAlignment="Center" Foreground="#1565C0" FontWeight="SemiBold" Margin="0,0,10,0" MaxWidth="250" TextTrimming="CharacterEllipsis"/>
                            <Button Content="📍 Sélectionner" Command="{Binding OpenVilleCPFilterCommand}" Padding="8,3"
                                    Background="#E3F2FD" Foreground="#1565C0" Style="{StaticResource BaseButtonStyle}" Margin="0,0,5,0"/>
                            <Button Content="🔄 Effacer filtres" Command="{Binding ClearAllFiltersCommand}" Padding="8,3"
                                    Background="#FFF3E0" Foreground="#E65100" Style="{StaticResource BaseButtonStyle}" Margin="0,0,5,0"/>
                            <Button Content="🔄" Command="{Binding LoadCommand}" Padding="8,3"
                                    Background="#EEE" Style="{StaticResource BaseButtonStyle}" ToolTip="Actualiser"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- DataGrid -->
                <DataGrid Grid.Row="2" ItemsSource="{Binding Commandes}" SelectedItem="{Binding SelectedCommande}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          Background="White" BorderBrush="#DDD" BorderThickness="1" 
                          GridLinesVisibility="Horizontal" RowHeight="38" HeadersVisibility="Column"
                          CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="N° Commande" Binding="{Binding NumeroCommande}" Width="150" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="100"/>
                        <DataGridTextColumn Header="Prénom" Binding="{Binding Prenom}" Width="100"/>
                        <DataGridTextColumn Header="Téléphone" Binding="{Binding Telephone}" Width="110"/>
                        <DataGridTextColumn Header="Ville / CP" Binding="{Binding VilleCodePostal}" Width="130"/>
                        <DataGridTextColumn Header="Articles" Binding="{Binding NbArticles}" Width="60"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalAvecLivraison, StringFormat=C}" Width="80" FontWeight="Bold"/>
                        <DataGridTemplateColumn Header="Restant" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Restant, StringFormat=C}" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#C62828"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatutPaiement}" Value="regle">
                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Statut" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatutDisplay}" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#F57F17"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Statut}" Value="traitee">
                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Statut}" Value="annulee">
                                                        <Setter Property="Foreground" Value="#C62828"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Right: Detail Panel -->
            <Grid Grid.Column="1">
                <!-- Empty State -->
                <Border Background="White" BorderBrush="#DDD" BorderThickness="1" Padding="20">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="👈 Sélectionner une commande" FontSize="16" Foreground="#BBB" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Detail View -->
                <Border Background="White" BorderBrush="#DDD" BorderThickness="1" Padding="20"
                        Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Détail de la Commande" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="#1565C0"/>

                        <!-- Client Info -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,15">
                            <TextBlock Text="{Binding SelectedCommande.NumeroCommande}" FontSize="16" FontWeight="Bold" Foreground="#1565C0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="{Binding SelectedCommande.Prenom}" FontWeight="SemiBold"/>
                                <TextBlock Text=" "/>
                                <TextBlock Text="{Binding SelectedCommande.Nom}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedCommande.Telephone}" Foreground="#666"/>
                            <TextBlock Text="{Binding SelectedCommande.Adresse}" Foreground="#666"
                                       Visibility="{Binding SelectedCommande.Adresse, Converter={StaticResource StringToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding SelectedCommande.VilleCodePostal}" Foreground="#666"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="Statut : " Foreground="#666"/>
                                <TextBlock Text="{Binding SelectedCommande.StatutDisplay}" FontWeight="SemiBold"/>
                                <TextBlock Text=" | " Foreground="#CCC" Margin="5,0"/>
                                <TextBlock Text="{Binding SelectedCommande.StatutPaiementDisplay}" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#C62828"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedCommande.StatutPaiement}" Value="regle">
                                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <!-- Lines -->
                        <DataGrid Grid.Row="2" ItemsSource="{Binding SelectedCommande.Lignes}" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="White" BorderThickness="0" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Produit" Binding="{Binding ProduitNom}" Width="*"/>
                                <DataGridTextColumn Header="Qté" Binding="{Binding Quantite, StringFormat=N2}" Width="50"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding TotalLigne, StringFormat=C}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Totals -->
                        <StackPanel Grid.Row="3" Margin="0,15,0,0">
                            <Border BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,5">
                                        <TextBlock Text="{Binding SelectedCommande.NbArticles, StringFormat='Nb Articles : {0}'}" Foreground="#666"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,5">
                                        <TextBlock Text="Total Articles" Foreground="#666"/>
                                        <TextBlock Text="{Binding SelectedCommande.Total, StringFormat=C}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,5" Visibility="{Binding SelectedCommande.AvecLivraison, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="🚚 Livraison" Foreground="#666"/>
                                        <TextBlock Text="{Binding SelectedCommande.MontantLivraison, StringFormat=C}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,5">
                                        <TextBlock Text="TOTAL À PAYER" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock Text="{Binding SelectedCommande.TotalAvecLivraison, StringFormat=C}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Right" Foreground="#1565C0"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,5">
                                        <TextBlock Text="Montant Payé" Foreground="#2E7D32"/>
                                        <TextBlock Text="{Binding SelectedCommande.MontantPaye, StringFormat=C}" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#2E7D32"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="RESTANT" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="{Binding SelectedCommande.Restant, StringFormat=C}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#C62828"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedCommande.StatutPaiement}" Value="regle">
                                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Row="4" Margin="0,10,0,0">
                            <UniformGrid Columns="2" Margin="0,0,0,5">
                                <Button Content="👁 Voir Ticket" Command="{Binding ViewTicketCommand}" 
                                        Background="#1565C0" Foreground="White" Padding="10,8" 
                                        Style="{StaticResource BaseButtonStyle}" Margin="0,0,3,0"/>
                                <Button Content="🖨 Imprimer" Command="{Binding PrintTicketCommand}" 
                                        Background="#4CAF50" Foreground="White" Padding="10,8" 
                                        Style="{StaticResource BaseButtonStyle}" Margin="3,0,0,0"/>
                            </UniformGrid>
                            <UniformGrid Columns="2" Margin="0,0,0,5">
                                <Button Content="✏ Modifier" Command="{Binding EditCommandeCommand}" 
                                        Background="#FF9800" Foreground="White" Padding="10,8" 
                                        Style="{StaticResource BaseButtonStyle}" Margin="0,0,3,0"/>
                                <Button Content="💰 Ajouter Paiement" Command="{Binding AddPaymentCommand}" 
                                        Background="#7B1FA2" Foreground="White" Padding="10,8" 
                                        Style="{StaticResource BaseButtonStyle}" Margin="3,0,0,0"/>
                            </UniformGrid>
                            <UniformGrid Columns="3">
                                <Button Content="✅ Traitée" Command="{Binding ChangeStatusCommand}" CommandParameter="traitee"
                                        Background="#E8F5E9" Foreground="#2E7D32" Padding="10,8" 
                                        Style="{StaticResource BaseButtonStyle}" Margin="0,0,3,0" FontWeight="Bold"/>
                                <Button Content="❌ Annuler" Command="{Binding ChangeStatusCommand}" CommandParameter="annulee"
                                        Background="#FFEBEE" Foreground="#C62828" Padding="10,8" 
                                        Style="{StaticResource BaseButtonStyle}" Margin="3,0,3,0" FontWeight="Bold"/>
                                <Button Content="🗑 Supprimer" Command="{Binding DeleteCommandeCommand}"
                                        Background="#FFCDD2" Foreground="#B71C1C" Padding="10,8" 
                                        Style="{StaticResource BaseButtonStyle}" Margin="3,0,0,0" FontWeight="Bold"/>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- NEW COMMANDE MODE (same layout as Caisse: SalesView + TicketView) -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsNewCommandeMode, Converter={StaticResource BoolToVis}}" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="750"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Product Catalog (exactly like SalesView) -->
            <Grid Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,10">
                    <TextBlock Text="📋 Nouvelle Commande" FontSize="22" FontWeight="Bold" Foreground="#1565C0"/>
                    <Button Content="◀ Retour à la liste" Command="{Binding CancelNewCommandeCommand}"
                            HorizontalAlignment="Right" Padding="12,6"
                            Background="#FFEBEE" Foreground="#C62828" FontWeight="Bold"
                            Style="{StaticResource BaseButtonStyle}"/>
                </Grid>

                <!-- Search Bar (exact copy from SalesView) -->
                <Border Grid.Row="1" Background="White" CornerRadius="20" Padding="15,5" Margin="0,0,0,20" BorderBrush="#EEEEEE" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" VerticalAlignment="Center" Margin="5,0,10,0" Foreground="Gray" FontSize="16"/>

                        <ComboBox x:Name="searchComboCmd" Grid.Column="1"
                                  IsEditable="True" IsTextSearchEnabled="False"
                                  IsTextSearchCaseSensitive="False" StaysOpenOnEdit="True"
                                  BorderThickness="0" VerticalAlignment="Center" FontSize="16"
                                  ItemsSource="{Binding SearchSuggestions}"
                                  Text="{Binding NewCommandeSearchText, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedItem="{Binding SelectedSearchProduct}"
                                  IsDropDownOpen="{Binding IsSearchDropDownOpen, Mode=TwoWay}"
                                  Loaded="searchComboCmd_Loaded"
                                  Foreground="#333">
                            <ComboBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ScanNewCommandeCommand}"/>
                            </ComboBox.InputBindings>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="550" Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="45"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Product Image -->
                                        <Border Width="40" Height="40" CornerRadius="4" Background="#F8F8F8" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding FullImagePath, Converter={StaticResource PathToImage}}" Stretch="Uniform" Margin="2"/>
                                                <TextBlock Text="📦" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#CCC"
                                                           Visibility="{Binding FullImagePath, Converter={StaticResource InvertedNullToVis}}"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Nom}" FontWeight="Bold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="8,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PrixVente, StringFormat={}{0:C}}" Foreground="#2E7D32" FontWeight="Bold"/>
                                            <TextBlock Foreground="#777" Margin="2,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="/Unité"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TypeVente}" Value="poids">
                                                                <Setter Property="Text" Value="/kg"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Grid.Column="2" Content="✕" Command="{Binding ClearNewCommandeSearchCommand}"
                                Background="Transparent" BorderThickness="0" Foreground="#999" FontSize="18" Padding="8" Cursor="Hand"
                                ToolTip="Effacer la recherche"/>
                    </Grid>
                </Border>

                <!-- Top Products (exact copy from SalesView with images) -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,10">
                            <TextBlock Text="Top Produits" FontSize="20" FontWeight="Bold" Foreground="#333"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding TopProducts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Left"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="160" Height="180" Margin="8" Style="{StaticResource ProductCardStyle}">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.AddToCommandePanierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <!-- Product Image (with fallback) -->
                                            <Border Grid.Row="0" Margin="5" CornerRadius="8" Background="#F8F8F8" ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding FullImagePath, Converter={StaticResource PathToImage}}" Stretch="Uniform" Margin="5"/>
                                                    <TextBlock Text="📦" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#CCCCCC"
                                                               Visibility="{Binding FullImagePath, Converter={StaticResource InvertedNullToVis}}"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Grid.Row="1" Text="{Binding Nom}" FontWeight="Bold" FontSize="13" 
                                                       Margin="5,5,5,0" HorizontalAlignment="Center" TextAlignment="Center"
                                                       TextWrapping="Wrap" MaxHeight="45" VerticalAlignment="Top" Foreground="#333333"/>
                                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,5">
                                                <TextBlock Text="{Binding PrixVente, StringFormat={}{0:C}}" FontSize="14" FontWeight="SemiBold" Foreground="#2E7D32"/>
                                                <TextBlock FontSize="11" Foreground="#777" VerticalAlignment="Bottom" Margin="2,0,0,1">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="/Unité"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TypeVente}" Value="poids">
                                                                    <Setter Property="Text" Value="/kg"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Right: Commande Panier (same width & layout as TicketView) -->
            <Border Grid.Column="1" Background="White" BorderBrush="#DDD" BorderThickness="1,0,0,0" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header (same as TicketView with suspended section in top-right) -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Panier Commande" FontSize="24" FontWeight="Bold" Foreground="#1565C0"/>
                        </StackPanel>

                        <!-- Suspended Commandes Resume Section (exactly like TicketView) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SuspendedCommandes.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <ComboBox x:Name="cbSuspendedCmd" ItemsSource="{Binding SuspendedCommandes}" Width="180" Margin="0,0,5,0"
                                      Height="30" VerticalContentAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="📂" Command="{Binding ResumeCommandeCommand}" CommandParameter="{Binding ElementName=cbSuspendedCmd, Path=SelectedItem}"
                                    Background="#FFF8E1" Foreground="#F57F17" BorderThickness="0" Width="30" Height="30">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="5"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Cart List (exact copy from TicketView with image, P.U, Qty, Total, delete) -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding CommandePanier}" AutoGenerateColumns="False" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0"
                              SelectionMode="Single" RowHeight="50">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="40" Height="40" CornerRadius="4" Background="#F8F8F8" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding Produit.FullImagePath, Converter={StaticResource PathToImage}}" Stretch="Uniform" Margin="2"/>
                                                <TextBlock Text="📦" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#CCC"
                                                           Visibility="{Binding Produit.FullImagePath, Converter={StaticResource InvertedNullToVis}}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Produit" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="5">
                                            <TextBlock Text="{Binding ProduitNom}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding PromotionAppliquee}" Foreground="#2E7D32" FontSize="11" FontStyle="Italic"
                                                       Visibility="{Binding PromotionAppliquee, Converter={StaticResource StringToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="P.U" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PrixUnitaire, StringFormat={}{0:C}}" FontSize="12"/>
                                            <TextBlock FontSize="10" Foreground="Gray" VerticalAlignment="Bottom" Margin="2,0,0,1">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="/u"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Produit.TypeVente}" Value="poids">
                                                                <Setter Property="Text" Value="/kg"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Qté" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="-" Command="{Binding DecreaseQuantityCommand}" Width="25" Height="25"/>
                                            <TextBlock Text="{Binding Quantite}" Width="35" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold">
                                                <TextBlock.InputBindings>
                                                    <MouseBinding MouseAction="LeftDoubleClick" 
                                                                  Command="{Binding DataContext.EditCommandeQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                  CommandParameter="{Binding}"/>
                                                </TextBlock.InputBindings>
                                            </TextBlock>
                                            <Button Content="+" Command="{Binding IncreaseQuantityCommand}" Width="25" Height="25"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Total" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TotalLigneStandard, StringFormat={}{0:C}}" 
                                                       TextDecorations="Strikethrough" Foreground="Gray" FontSize="11"
                                                       Visibility="{Binding HasPromotion, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='True'}"
                                                       HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding TotalLigne, StringFormat={}{0:C}}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="❌" Command="{Binding DataContext.RemoveCommandeItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Foreground="Red"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Totals & Options -->
                    <StackPanel Grid.Row="2" Margin="0,10">
                        <Separator Background="#EEE" Margin="0,0,0,10"/>

                        <!-- Livraison -->
                        <StackPanel Margin="0,0,0,10">
                            <CheckBox Content="🚚 Avec livraison" IsChecked="{Binding AvecLivraison}" FontWeight="SemiBold" FontSize="13"/>
                            <Grid Margin="25,5,0,0" Visibility="{Binding AvecLivraison, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Montant livraison :" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding MontantLivraison, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                         Width="100" FontWeight="Bold" HorizontalAlignment="Right" VerticalContentAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <!-- Remise display -->
                        <DockPanel Margin="0,0,0,3" Visibility="{Binding CommandeTotalRemise, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="Total hors remise" FontSize="14" Foreground="Gray"/>
                            <TextBlock Text="{Binding CommandeTotalSansRemise, StringFormat={}{0:C}}" FontSize="14" FontWeight="Bold" Foreground="Gray" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,3" Visibility="{Binding CommandeTotalRemise, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="Total Remise" FontSize="14" Foreground="#C62828"/>
                            <TextBlock Text="{Binding CommandeTotalRemise, StringFormat={}-{0:C}}" FontSize="14" FontWeight="Bold" Foreground="#C62828" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <Border Background="#E3F2FD" CornerRadius="8" Padding="15" Margin="0,5,0,10">
                            <Grid>
                                <TextBlock Text="Total à payer" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#1565C0"/>
                                <TextBlock Text="{Binding CommandeTotalAvecLivraison, StringFormat={}{0:C}}" FontSize="32" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- Montant payé -->
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Payé :" VerticalAlignment="Center" FontSize="14"/>
                            <TextBox Grid.Column="2" Text="{Binding MontantPaye, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" 
                                     Width="100" FontSize="20" FontWeight="Bold" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="3" Content="= Exact" Command="{Binding FillExactAmountCommand}" 
                                    Margin="5,0,0,0" Padding="8,4" FontSize="12" FontWeight="SemiBold"
                                    Background="#E3F2FD" Foreground="#1565C0" BorderBrush="#1565C0" Cursor="Hand" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,5">
                            <TextBlock Text="Restant :" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CommandeRestant, StringFormat={}{0:C}}" FontSize="24" FontWeight="Bold" Foreground="#C62828" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>

                    <!-- Actions (same buttons as Caisse: Vider, Remise, Attente + Valider) -->
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <UniformGrid Columns="3" Margin="0,0,0,10">
                            <Button Content="🗑️ VIDER" Command="{Binding ViderCommandePanierCommand}" Height="45" Margin="0,0,5,0"
                                    ToolTip="Vider le panier" Background="#FFEBEE" Foreground="#C62828" FontWeight="Bold"/>
                            <Button Content="🏷️ REMISE" Command="{Binding OpenCommandeDiscountCommand}" Height="45" Margin="5,0,5,0"
                                    ToolTip="Remise"/>
                            <Button Content="📂 ATTENTE" Command="{Binding SuspendCommandeCommand}" Height="45" Margin="5,0,0,0"
                                    ToolTip="Mettre en attente" Background="#FFF3E0" Foreground="#E65100" FontWeight="Bold"/>
                        </UniformGrid>

                        <Button Grid.Row="2" Content="VALIDER LA COMMANDE" Command="{Binding ValidateCommandeCommand}" Height="60"
                                Background="#1565C0" Foreground="White" FontSize="22" FontWeight="Bold">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

