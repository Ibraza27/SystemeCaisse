<Window x:Class="SystemeCaisse.UI.Views.DiscountValueInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Saisir la Remise" Height="300" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F5F7">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleTxt" Text="Valeur de la remise" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

        <Grid Grid.Row="1" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ValueInput" FontSize="32" FontWeight="Bold" Padding="10" HorizontalContentAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="UnitTxt" Grid.Column="1" Text="%" FontSize="32" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Annuler" IsCancel="True" Padding="15,10" Foreground="Gray" Background="Transparent" BorderThickness="0" Margin="0,0,10,0"/>
            <Button Content="Valider" Click="BtnValidate_Click" IsDefault="True" Padding="25,10" Background="#2E7D32" Foreground="White" FontWeight="Bold" FontSize="18"/>
        </StackPanel>
    </Grid>
</Window>
