<Window x:Class="SystemeCaisse.UI.Views.QuantityInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quantité" Height="200" Width="300"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Modifier Quantité" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
        
        <TextBox x:Name="QtyInput" Grid.Row="1" FontSize="20" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Annuler" IsCancel="True" Width="80" Height="30" Margin="0,0,10,0"/>
            <Button Content="OK" IsDefault="True" Click="BtnOK_Click" Width="80" Height="30" Background="#1976D2" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
