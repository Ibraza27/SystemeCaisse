<Window x:Class="SystemeCaisse.UI.Views.CustomerWeightDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pesée en cours" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True"
        WindowStartupLocation="Manual" ShowInTaskbar="False">

    <Border Background="#1A1A2E" CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border CornerRadius="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#0D47A1" Offset="0"/>
                        <GradientStop Color="#1565C0" Offset="0.5"/>
                        <GradientStop Color="#1976D2" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Margin="30,20">
                    <TextBlock Text="⚖️  PESÉE EN COURS" FontSize="32" FontWeight="Bold" Foreground="White" 
                               HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                </StackPanel>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="40,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Product Info -->
                <Border Background="#16213E" CornerRadius="20" Padding="30,25" Margin="0,0,0,25">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Product Image -->
                        <Border x:Name="ImageBorder" Width="140" Height="140" CornerRadius="15" Background="#0F3460" 
                                ClipToBounds="True" Margin="0,0,25,0" Visibility="Collapsed">
                            <Image x:Name="ProductImage" Stretch="Uniform" Margin="8"/>
                        </Border>

                        <!-- No Image Placeholder -->
                        <Border x:Name="NoImageBorder" Width="140" Height="140" CornerRadius="15" Background="#0F3460"
                                Margin="0,0,25,0" Visibility="Visible">
                            <TextBlock Text="📦" FontSize="60" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#333"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="ProductNameText" Text="Produit" FontSize="36" FontWeight="Bold" 
                                       Foreground="White" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <Border Background="#E65100" CornerRadius="12" Padding="20,8" HorizontalAlignment="Left">
                                <TextBlock x:Name="PricePerKgText" Text="0.00 €/kg" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Live Weight + Price -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Weight -->
                    <Border Background="#0F3460" CornerRadius="20" Padding="20" Margin="0,0,12,0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="POIDS" FontSize="20" FontWeight="Bold" Foreground="#64B5F6" 
                                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock x:Name="WeightText" Text="0,000" FontSize="100" FontWeight="Black" 
                                       Foreground="#42A5F5" HorizontalAlignment="Center" FontFamily="Consolas"/>
                            <TextBlock Text="kg" FontSize="32" Foreground="#64B5F6" HorizontalAlignment="Center" Margin="0,-10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Price -->
                    <Border Grid.Column="1" Background="#1B5E20" CornerRadius="20" Padding="20" Margin="12,0,0,0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="À PAYER" FontSize="20" FontWeight="Bold" Foreground="#81C784" 
                                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock x:Name="TotalPriceText" Text="0,00" FontSize="100" FontWeight="Black" 
                                       Foreground="#66BB6A" HorizontalAlignment="Center" FontFamily="Consolas"/>
                            <TextBlock Text="€" FontSize="32" Foreground="#81C784" HorizontalAlignment="Center" Margin="0,-10,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Status Bar -->
                <Border Grid.Row="2" Background="#16213E" CornerRadius="12" Padding="15,10" Margin="0,20,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="StatusIcon" Text="🟢" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" Text="Balance connectée" FontSize="16" Foreground="#81C784" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
