<Window x:Class="SystemeCaisse.UI.Views.CommandeClientInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Informations Client" Width="540" Height="740"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="📋 Informations du Client" FontSize="20" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Nom -->
                <TextBlock Text="Nom *" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="tbNom" FontSize="14" Padding="8,6" Margin="0,0,0,10" CharacterCasing="Upper"/>

                <!-- Prénom -->
                <TextBlock Text="Prénom *" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="tbPrenom" FontSize="14" Padding="8,6" Margin="0,0,0,10" CharacterCasing="Upper"/>

                <!-- Téléphone -->
                <TextBlock Text="Téléphone *" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="tbTelephone" FontSize="14" Padding="8,6" Margin="0,0,0,10"/>

                <!-- Adresse -->
                <TextBlock Text="Adresse" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,3"/>
                <TextBox x:Name="tbAdresse" FontSize="14" Padding="8,6" Margin="0,0,0,10"/>

                <!-- Code Postal & Ville -->
                <Grid Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Code Postal" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Ville" FontWeight="SemiBold" Margin="0,0,0,3"/>

                    <TextBox x:Name="tbCodePostal" Grid.Row="1" Grid.Column="0" FontSize="14" Padding="8,6"
                             TextChanged="TbCodePostal_TextChanged"
                             PreviewKeyDown="VilleInput_PreviewKeyDown"
                             ToolTip="Tapez le code postal (ex: 75001, 27000)"/>

                    <TextBox x:Name="tbVilleSearch" Grid.Row="1" Grid.Column="2" FontSize="14" Padding="8,6"
                             TextChanged="TbVilleSearch_TextChanged"
                             PreviewKeyDown="VilleInput_PreviewKeyDown"
                             ToolTip="Tapez le nom de la ville ou un code postal"/>

                    <ListBox x:Name="lbVilleSuggestions" Grid.Row="2" Grid.ColumnSpan="3" MaxHeight="160"
                             PreviewMouseLeftButtonUp="LbVilleSuggestions_PreviewMouseLeftButtonUp"
                             PreviewKeyDown="LbVilleSuggestions_PreviewKeyDown"
                             BorderBrush="#1565C0" BorderThickness="1" Background="White" Margin="0,3,0,0"
                             Visibility="Collapsed">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <TextBlock Text="{Binding CodePostal}" FontWeight="Bold" Foreground="#1565C0" Width="55"/>
                                    <TextBlock Text="— " Foreground="#999"/>
                                    <TextBlock Text="{Binding Ville}" FontWeight="SemiBold" Foreground="#333"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- Commentaire -->
                <TextBlock Text="💬 Commentaire (visible dans le détail et sur le ticket)" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,3"/>
                <TextBox x:Name="tbCommentaire" FontSize="13" Padding="8,6" Height="65"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         ToolTip="Instructions spéciales, heure de retrait, digicode, note client..."/>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <UniformGrid Columns="2" Margin="0,0,0,8">
                <Button Content="✅ Confirmer la Commande" Click="Confirm_Click" Height="48" Margin="0,0,5,0"
                        Background="#1565C0" Foreground="White" FontSize="14" FontWeight="Bold" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
                <Button Content="◀ Retour au Panier" Click="Back_Click" Height="48" Margin="5,0,0,0"
                        Background="#EEE" Foreground="#333" FontSize="14" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
            </UniformGrid>
            <Button Grid.Row="1" Content="❌ Annuler tout" Click="Cancel_Click" Height="38"
                    Background="#FFEBEE" Foreground="#C62828" FontWeight="SemiBold" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
