<Window x:Class="SystemeCaisse.UI.Views.CommandeClientRecapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Récapitulatif Clients" Width="700" Height="700"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="White">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,15">
            <TextBlock Text="👥 Récapitulatif des Clients" FontSize="20" FontWeight="Bold" Foreground="#7B1FA2"/>
            <TextBlock x:Name="tbSubtitle" FontSize="12" Foreground="#666" Margin="0,5,0,0"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="dgRecap" AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White"
                  BorderBrush="#DDD" BorderThickness="1" RowHeight="35">
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Border Background="#E8EAF6" Padding="8,5" CornerRadius="3" Margin="0,3,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📍" FontSize="13" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#283593"/>
                                    <TextBlock Text=" — " Foreground="#999"/>
                                    <TextBlock Text="{Binding ItemCount}" FontWeight="SemiBold" Foreground="#283593"/>
                                    <TextBlock Text=" client(s)" Foreground="#666"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Client" Binding="{Binding ClientDisplay}" Width="*" FontWeight="SemiBold"/>
                <DataGridTextColumn Header="Téléphone" Binding="{Binding Telephone}" Width="120"/>
                <DataGridTextColumn Header="Commandes" Binding="{Binding NbCommandes}" Width="90" FontWeight="Bold"/>
                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='{}{0:0.00} €'}" Width="100" FontWeight="Bold"/>
                <DataGridTextColumn Header="Payé" Binding="{Binding Paye, StringFormat='{}{0:0.00} €'}" Width="100"/>
                <DataGridTemplateColumn Header="Restant" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Restant, StringFormat='{}{0:0.00} €'}" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#C62828"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRegle}" Value="True">
                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="🖨 Imprimer" Click="Print_Click" Width="150" Height="45" Margin="0,0,10,0"
                    Background="#4CAF50" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
            <Button Content="Fermer" Click="Close_Click" Width="150" Height="45"
                    Background="#EEE" Foreground="#333" FontWeight="SemiBold" FontSize="14" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
