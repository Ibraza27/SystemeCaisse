<UserControl x:Class="SystemeCaisse.UI.Views.StocksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:views="clr-namespace:SystemeCaisse.UI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#DDD" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid Margin="10">
        <TabControl BorderThickness="0" Background="Transparent" SelectedIndex="0">
             <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Padding" Value="15,8"/>
                    <Setter Property="Margin" Value="0,0,5,0"/>
                    <Setter Property="Background" Value="#F5F5F5"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5,5,0,0" Padding="{TemplateBinding Padding}" BorderBrush="#DDD" BorderThickness="1,1,1,0">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="White"/>
                                        <Setter TargetName="Bd" Property="BorderThickness" Value="1,1,1,0"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#0277BD"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
             </TabControl.Resources>

            <!-- 1. Vue d'ensemble -->
            <TabItem Header="📊 Vue d'ensemble">
                 <views:StockOverviewView/>
            </TabItem>

            <!-- 2. Mouvements de Stock (Existing + Form) -->
            <TabItem Header="📦 Mouvements de stock">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="350"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- History List -->
                    <DataGrid Grid.Column="0" ItemsSource="{Binding Mouvements}" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="White" BorderThickness="0" GridLinesVisibility="Horizontal" RowHeight="35"
                              HeadersVisibility="Column" Margin="0,0,20,0">
                         <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding DateMouvement, StringFormat=dd/MM/yyyy HH:mm}" Width="120"/>
                            <DataGridTextColumn Header="Produit" Binding="{Binding Produit.Nom}" Width="*"/>
                             <DataGridTemplateColumn Header="Type" Width="80">
                                 <DataGridTemplateColumn.CellTemplate>
                                     <DataTemplate>
                                         <TextBlock Text="{Binding TypeMouvement}" FontWeight="Bold">
                                             <TextBlock.Style>
                                                 <Style TargetType="TextBlock">
                                                     <Style.Triggers>
                                                         <DataTrigger Binding="{Binding TypeMouvement}" Value="entree">
                                                             <Setter Property="Foreground" Value="Green"/>
                                                         </DataTrigger>
                                                         <DataTrigger Binding="{Binding TypeMouvement}" Value="sortie">
                                                             <Setter Property="Foreground" Value="Red"/>
                                                         </DataTrigger>
                                                     </Style.Triggers>
                                                 </Style>
                                             </TextBlock.Style>
                                         </TextBlock>
                                     </DataTemplate>
                                 </DataGridTemplateColumn.CellTemplate>
                             </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Quantité" Binding="{Binding Quantite}" Width="80"/>
                            <DataGridTextColumn Header="Commentaire" Binding="{Binding Commentaire}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Add Movement Form -->
                    <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20">
                        <Border.Effect>
                            <DropShadowEffect Color="#DDD" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Nouveau Mouvement" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>
        
                            <TextBlock Text="Produit" Foreground="#666" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding Produits}" DisplayMemberPath="Nom" SelectedItem="{Binding SelectedProduitMouvement}" 
                                      Padding="8" Margin="0,0,0,15"/>
        
                            <TextBlock Text="Type" Foreground="#666" Margin="0,0,0,5"/>
                            <ComboBox SelectedValue="{Binding TypeMouvement}" SelectedValuePath="Content" Padding="8" Margin="0,0,0,15">
                                <ComboBoxItem Content="entree"/>
                                <ComboBoxItem Content="sortie"/>
                                <ComboBoxItem Content="inventaire"/>
                            </ComboBox>
        
                            <TextBlock Text="Quantité" Foreground="#666" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding QuantiteMouvement, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,15"/>
        
                            <StackPanel Visibility="{Binding TypeMouvement, Converter={StaticResource BoolToVis}}"> 
                                <TextBlock Text="Prix Achat Unitaire (€) (si entrée)" Foreground="#666" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding PrixUnitaireMouvement, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,15"/>
                            </StackPanel>
        
                            <TextBlock Text="Commentaire" Foreground="#666" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding CommentaireMouvement, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,20"/>
        
                            <Button Content="Valider le mouvement" Command="{Binding ValiderMouvementCommand}" 
                                    Background="#2E7D32" Foreground="White" Padding="12" Style="{StaticResource BaseButtonStyle}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 3. Inventaire -->
            <TabItem Header="📋 Inventaire">
                <ContentControl Content="{Binding DataContext.InventoryVM, RelativeSource={RelativeSource AncestorType=Window}}">
                     <ContentControl.ContentTemplate>
                         <DataTemplate>
                             <views:InventoryView/>
                         </DataTemplate>
                     </ContentControl.ContentTemplate>
                </ContentControl>
            </TabItem>

            <!-- 4. Commandes Fournisseurs (Placeholder) -->
             <TabItem Header="🚚 Commandes Fournisseurs">
                 <Grid Background="White">
                     <TextBlock Text="Module Commandes Fournisseurs - À venir" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray" FontSize="16"/>
                 </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>

