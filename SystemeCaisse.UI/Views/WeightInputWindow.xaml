<Window x:Class="SystemeCaisse.UI.Views.WeightInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Saisie Poids" Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#E0F7FA" CornerRadius="5" Margin="0,0,0,20" Padding="15">
            <StackPanel>
                 <TextBlock Text="⚖️ Produit au Poids" FontSize="18" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                 <Separator Margin="0,5,0,10" Background="#B0BEC5"/>
                 
                 <Border Width="80" Height="80" CornerRadius="8" Background="White" HorizontalAlignment="Center" Margin="0,0,0,10" ClipToBounds="True">
                     <Grid>
                         <Image Source="{Binding FullImagePath, Converter={StaticResource PathToImage}}" Stretch="Uniform" Margin="5"/>
                         <TextBlock Text="📦" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#CCC"
                                    Visibility="{Binding FullImagePath, Converter={StaticResource InvertedNullToVis}}"/>
                     </Grid>
                 </Border>
                 
                 <TextBlock x:Name="ProductNameTxt" Text="Produit" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#0277BD" TextWrapping="Wrap" TextAlignment="Center"/>
                 <TextBlock x:Name="ProductPriceTxt" Text="0.00 €/kg" FontSize="16" HorizontalAlignment="Center" Foreground="#455A64" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <TextBlock Text="Poids (kg) :" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="WeightInput" Grid.Row="1" FontSize="24" FontWeight="Bold" Padding="5" HorizontalContentAlignment="Center"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Annuler" IsCancel="True" Width="100" Height="40" Margin="0,0,10,0" Background="#FFEBEE" Foreground="#D32F2F" BorderThickness="0">
                 <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Valider" IsDefault="True" Click="BtnValider_Click" Width="100" Height="40" Background="#2E7D32" Foreground="White" BorderThickness="0">
                 <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
