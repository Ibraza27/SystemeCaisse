<UserControl x:Class="SystemeCaisse.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:SystemeCaisse.UI.ViewModels"
             xmlns:views="clr-namespace:SystemeCaisse.UI.Views"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#F5F5F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="⚙️ Paramètres" FontSize="24" FontWeight="Bold" Margin="20,20,0,20" Foreground="#333"/>
        
        <!-- Tabs -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="20,0,20,20">
            <TabControl Background="White" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Padding" Value="15,10"/>
                    </Style>
                </TabControl.Resources>

                <!-- General Tab -->
                <TabItem Header="🏢 Entreprise">
                    <StackPanel Margin="20" MaxWidth="600" HorizontalAlignment="Left">
                        <GroupBox Header="Informations De l'Entreprise" Padding="15">
                            <StackPanel>
                                <Label Content="Nom de l'entreprise"/>
                                <TextBox Text="{Binding EntrepriseInfo.Nom}" Padding="5" Margin="0,0,0,10"/>

                                <Label Content="Adresse"/>
                                <TextBox Text="{Binding EntrepriseInfo.Adresse}" Padding="5" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>

                                <Label Content="Téléphone"/>
                                <TextBox Text="{Binding EntrepriseInfo.Telephone}" Padding="5" Margin="0,0,0,10"/>

                                <Label Content="Horaires (Lundi - Samedi)"/>
                                <TextBox Text="{Binding EntrepriseInfo.HorairesSemaine}" Padding="5" Margin="0,0,0,10"/>

                                <Label Content="Horaires (Dimanche)"/>
                                <TextBox Text="{Binding EntrepriseInfo.HorairesDimanche}" Padding="5" Margin="0,0,0,10"/>
                                
                                <Label Content="Chemin du Logo"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding EntrepriseInfo.LogoPath}" Padding="5" IsReadOnly="True"/>
                                    <Button Grid.Column="1" Content="..." Width="30" Margin="5,0,0,0"
                                            Command="{Binding SelectLogoCommand}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </TabItem>

                <!-- Peripherals Tab -->
                <TabItem Header="🖨️ Périphériques">
                    <StackPanel Margin="20" MaxWidth="600" HorizontalAlignment="Left">
                        <GroupBox Header="Impression Ticket" Padding="15">
                            <StackPanel>
                                <Label Content="Imprimante par défaut"/>
                                <ComboBox ItemsSource="{Binding AvailablePrinters}" SelectedItem="{Binding SelectedPrinter}" Padding="5" Margin="0,0,0,15"/>

                                <Label Content="Largeur du Ticket (mm)"/>
                                <StackPanel Orientation="Horizontal">
                                    <Slider Value="{Binding TicketWidth}" Minimum="58" Maximum="80" Width="200" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding TicketWidth}" VerticalAlignment="Center" FontWeight="Bold"/>
                                    <TextBlock Text=" mm" VerticalAlignment="Center"/>
                                </StackPanel>

                                <CheckBox Content="Afficher le Logo sur le ticket" IsChecked="{Binding ShowLogoOnTicket}" Margin="0,15,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="⚖️ Balance (RS-232)" Padding="15" Margin="0,20,0,0">
                            <StackPanel>
                                <CheckBox Content="Activer la balance connectée" IsChecked="{Binding IsScaleEnabled}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                
                                <StackPanel IsEnabled="{Binding IsScaleEnabled}">
                                    <Label Content="Port COM de la balance"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding AvailableComPorts}" SelectedItem="{Binding ScalePortName}" Padding="5" Margin="0,0,10,0"/>
                                        <Button Grid.Column="1" Content="🔄" Command="{Binding RefreshComPortsCommand}" Width="35" Height="30" ToolTip="Rafraîchir les ports COM"/>
                                    </Grid>

                                    <Label Content="Vitesse (Baud Rate)" Margin="0,10,0,0"/>
                                    <ComboBox ItemsSource="{Binding AvailableBaudRates}" SelectedItem="{Binding ScaleBaudRate}" Padding="5" Margin="0,0,0,10"/>

                                    <Button Content="🔍 Tester la connexion" Command="{Binding TestScaleConnectionCommand}" 
                                            Background="#FF9800" Foreground="White" Padding="10,5" HorizontalAlignment="Left" Margin="0,0,0,10">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                    </Button>
                                    
                                    <TextBlock Text="{Binding ScaleTestStatus}" FontSize="12" Foreground="#666" FontStyle="Italic" TextWrapping="Wrap"/>

                                    <!-- === SECTION TEST PRIX AFFICHEUR === -->
                                    <Separator Margin="0,15,0,10"/>
                                    <TextBlock Text="🧪 Test envoi prix vers afficheur" FontSize="14" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,10"/>
                                    <TextBlock Text="Testez différents formats de commande pour envoyer le prix unitaire à l'afficheur de la balance." 
                                               FontSize="11" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                    <Label Content="Format de commande"/>
                                    <ComboBox ItemsSource="{Binding AvailablePriceFormats}" SelectedItem="{Binding SelectedPriceFormat}" Padding="5" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding PriceFormatDescription}" FontSize="11" Foreground="#888" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                    <Label Content="Prix test (ex: 5.90)"/>
                                    <TextBox Text="{Binding TestPriceValue, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,0,0,5" FontSize="14"/>
                                    <TextBlock Text="{Binding TestPricePreview}" FontSize="11" Foreground="#1565C0" FontFamily="Consolas" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="📤 Envoyer le test" Command="{Binding SendTestPriceCommand}" 
                                                Background="#1565C0" Foreground="White" Padding="10,5" Margin="0,0,5,0">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                        </Button>
                                        <Button Grid.Column="1" Content="📤 Tester tous" Command="{Binding SendAllPriceFormatsCommand}" 
                                                Background="#7B1FA2" Foreground="White" Padding="10,5" Margin="5,0,0,0"
                                                ToolTip="Envoie le prix avec chaque format (2s entre chaque)">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                        </Button>
                                    </Grid>

                                    <TextBlock Text="{Binding PriceTestResult}" FontSize="12" Foreground="#666" FontStyle="Italic" TextWrapping="Wrap" Margin="0,5,0,0"/>

                                    <!-- Commande personnalisée -->
                                    <Separator Margin="0,10,0,10"/>
                                    <TextBlock Text="⌨️ Commande personnalisée (avancé)" FontSize="12" FontWeight="SemiBold" Foreground="#666"/>
                                    <TextBlock Text="Envoyez une commande brute au port série (le \\r\\n est ajouté automatiquement)." 
                                               FontSize="11" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding CustomScaleCommand, UpdateSourceTrigger=PropertyChanged}" Padding="5" FontFamily="Consolas" Margin="0,0,5,0"/>
                                        <Button Grid.Column="1" Content="📤" Command="{Binding SendCustomCommandCommand}" Width="40" Height="30" 
                                                Background="#455A64" Foreground="White" ToolTip="Envoyer">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="📺 Affichage Client (2ème Écran)" Padding="15" Margin="0,20,0,0">
                            <StackPanel>
                                <CheckBox Content="Activer l'affichage client" IsChecked="{Binding IsCustomerDisplayEnabled}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                
                                <Label Content="Sélectionner l'écran d'affichage"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding AvailableScreens}" 
                                              SelectedIndex="{Binding SelectedScreenIndex}" 
                                              IsEnabled="{Binding IsCustomerDisplayEnabled}"
                                              Padding="5" Margin="0,0,10,0"/>
                                    <Button Grid.Column="1" Content="🔄" Command="{Binding RefreshScreensCommand}" 
                                            Width="35" Height="30" ToolTip="Rafraîchir les écrans détectés"/>
                                </Grid>

                                <Button Content="Appliquer immédiatement" 
                                        Command="{Binding ApplyCustomerDisplayCommand}"
                                        IsEnabled="{Binding IsCustomerDisplayEnabled}"
                                        Background="#1976D2" Foreground="White" 
                                        Padding="10,5" HorizontalAlignment="Left" Margin="0,0,0,15"/>

                                <CheckBox Content="Afficher les promotions et publicités" 
                                          IsChecked="{Binding ShowCustomerDisplayPromotions}" 
                                          IsEnabled="{Binding IsCustomerDisplayEnabled}"
                                          Margin="0,5,0,0"/>

                                <CheckBox Content="Mode compact (petit écran)" 
                                          IsChecked="{Binding IsCompactCustomerDisplay}" 
                                          IsEnabled="{Binding IsCustomerDisplayEnabled}"
                                          Margin="0,10,0,0"
                                          ToolTip="Réduit les polices et optimise l'espace pour les petits écrans"/>

                                <GroupBox Header="Sélection des Promotions à Afficher" Margin="0,10,0,0">
                                    <GroupBox.Style>
                                        <Style TargetType="GroupBox">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowCustomerDisplayPromotions}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </GroupBox.Style>
                                    
                                    <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding AvailableDisplayPromotions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Promotion.Nom}" 
                                                              IsChecked="{Binding IsSelected}" 
                                                              Margin="2,2,0,2"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </GroupBox>
                                
                                <TextBlock Text="Note: L'affichage s'ouvrira sur l'écran sélectionné après avoir enregistré." 
                                           FontSize="11" Foreground="#666" Margin="0,10,0,0" FontStyle="Italic" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </TabItem>

                <!-- Promotions Tab -->
                <TabItem Header="🏷️ Promotions">
                    <views:PromotionsView DataContext="{Binding DataContext.PromotionsVM, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </TabItem>

                <!-- Caisse Tab -->
                <TabItem Header="🛒 Caisse">
                    <StackPanel Margin="20" MaxWidth="600" HorizontalAlignment="Left">
                        <GroupBox Header="Interface de Vente" Padding="15">
                            <StackPanel>
                                <Label Content="Nombre de Top Produits à afficher"/>
                                <StackPanel Orientation="Horizontal">
                                    <Slider Value="{Binding TopProductsCount}" Minimum="5" Maximum="50" Width="200" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding TopProductsCount}" VerticalAlignment="Center" FontWeight="Bold"/>
                                    <TextBlock Text=" produits" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Mettez à jour le nombre d'articles les plus vendus affichés dans l'onglet des favoris." Foreground="#666" FontSize="11" FontStyle="Italic" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </TabItem>

                <!-- System Tab -->
                <TabItem Header="🔧 Système">
                    <StackPanel Margin="20" MaxWidth="600" HorizontalAlignment="Left">
                         <!-- Training Mode -->
                         <GroupBox Header="Mode Formation" Padding="15" Margin="0,0,0,15" BorderBrush="#FF9500">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding IsTrainingMode}" Content="Activer le mode formation" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="⚠️ Les ventes ne seront PAS enregistrées." Foreground="#FF9500" Margin="24,5,0,0" FontStyle="Italic"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Maintenance de la Base de Données" Padding="15">
                            <StackPanel>
                                <TextBlock Text="Sauvegardez vos données régulièrement pour éviter toute perte." TextWrapping="Wrap" Margin="0,0,0,15" Foreground="#666"/>
                                <Button Command="{Binding BackupDatabaseCommand}" Content="📦 Créer une Sauvegarde (Backup)" Width="250" Height="40" HorizontalAlignment="Left" Background="#007AFF" Foreground="White"/>
                                <Button Command="{Binding RestoreDatabaseCommand}" Content="📥 Restaurer une Sauvegarde" Width="250" Height="40" HorizontalAlignment="Left" Background="#FF9500" Foreground="White" Margin="0,10,0,0"/>
                                
                                <TextBlock Text="Migration depuis l'ancienne version (Python)" FontWeight="SemiBold" Margin="0,15,0,5"/>
                                <Button Command="{Binding ImportDataCommand}" Content="📥 Importer depuis database.db" Width="250" Height="40" HorizontalAlignment="Left" Background="#5856D6" Foreground="White" Margin="0,5,0,0"/>

                                <Separator Margin="0,20"/>
                                <TextBlock Text="Actions Irréversibles" FontWeight="Bold" Foreground="#FF3B30" Margin="0,0,0,5"/>
                                <Button Command="{Binding ResetDatabaseCommand}" Content="🗑️ Réinitialiser la Base de Données" Width="250" Height="40" HorizontalAlignment="Left" Background="#FF3B30" Foreground="White"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </ScrollViewer>

        <!-- Save Button Footer -->
        <Border Grid.Row="2" Background="White" Padding="20" BorderBrush="#E5E5E5" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding SaveSettingsCommand}" Content="Enregistrer les Modifications" Background="#34C759" Foreground="White" Padding="20,10" FontWeight="Bold" FontSize="14"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
