<UserControl x:Class="SystemeCaisse.UI.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="500"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Search & List -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Historique des Ventes" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" Foreground="#333"/>
            
            <!-- Filters -->
            <Border Grid.Row="1" Background="White" Padding="10" Margin="0,0,0,10" CornerRadius="4" BorderBrush="#DDD" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Période :" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
                        <DatePicker SelectedDate="{Binding StartDate}" Width="100"/>
                        <TextBlock Text=" au " VerticalAlignment="Center" Margin="5,0"/>
                        <DatePicker SelectedDate="{Binding EndDate}" Width="100"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="15,0,0,0">
                            <Button Content="Aujourd'hui" Command="{Binding SetPeriodCommand}" CommandParameter="Today" Margin="0,0,5,0" Padding="8,2"/>
                            <Button Content="Hier" Command="{Binding SetPeriodCommand}" CommandParameter="Yesterday" Margin="0,0,5,0" Padding="8,2"/>
                            <Button Content="7 jours" Command="{Binding SetPeriodCommand}" CommandParameter="Week" Margin="0,0,5,0" Padding="8,2"/>
                            <Button Content="Ce mois" Command="{Binding SetPeriodCommand}" CommandParameter="Month" Margin="0,0,5,0" Padding="8,2"/>
                            <Button Content="Année" Command="{Binding SetPeriodCommand}" CommandParameter="Year" Padding="8,2"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Paiement" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold"/>
                        <ComboBox SelectedValue="{Binding PaymentFilter}"  Width="100">
                            <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Tous</System:String>
                            <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Espèces</System:String>
                            <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">CB</System:String>
                            <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Mixte</System:String>
                        </ComboBox>

                        <TextBlock Text="Ticket #" VerticalAlignment="Center" Margin="25,0,5,0" FontWeight="Bold"/>
                        <Grid Width="150">
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="5,2,25,2" VerticalContentAlignment="Center"/>
                            <Button Content="✕" Command="{Binding ClearSearchCommand}" 
                                    HorizontalAlignment="Right" VerticalAlignment="Center" 
                                    Width="18" Height="18" Margin="0,0,5,0"
                                    Background="Transparent" BorderThickness="0" Foreground="#AAA" Cursor="Hand"
                                    Visibility="{Binding SearchText.Length, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                        </Grid>
                        
                        <Button Content="🔄 Actualiser" Command="{Binding LoadCommand}" Margin="25,0,0,0" Padding="15,2"
                                Background="#EEE" Foreground="#333" Style="{StaticResource BaseButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- List -->
            <DataGrid Grid.Row="2" ItemsSource="{Binding Sales}" SelectedItem="{Binding SelectedSale}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      Background="White" BorderBrush="#DDD" BorderThickness="1" GridLinesVisibility="Horizontal" RowHeight="35"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding NumeroTicket}" Width="110"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="*"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="100" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Paiement" Binding="{Binding MoyenPaiement}" Width="100"/>
                    <DataGridTextColumn Header="Articles" Binding="{Binding NbArticles}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
            
            <!-- Stats Footer -->
            <Border Grid.Row="3" Background="#E8F5E9" Padding="10" Margin="0,10,0,0" CornerRadius="4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Margin="0,0,30,0">
                        <TextBlock Text="Espèces :" FontWeight="Bold" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding TotalCashPeriod, StringFormat=C}" FontWeight="Bold" Foreground="#2E7D32"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,30,0">
                        <TextBlock Text="CB :" FontWeight="Bold" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding TotalCardPeriod, StringFormat=C}" FontWeight="Bold" Foreground="#1976D2"/>
                    </StackPanel>
                    <TextBlock Text="Total Période :" FontWeight="Bold" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding TotalPeriod, StringFormat=C}" FontWeight="Bold" Foreground="#2E7D32"/>
                    <TextBlock Text=" (" Foreground="#666"/>
                    <TextBlock Text="{Binding CountPeriod}" Foreground="#666"/>
                    <TextBlock Text=" ventes)" Foreground="#666"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Right: Detail -->
        <Grid Grid.Column="1">
            <!-- Empty State -->
             <Border Background="White" BorderBrush="#DDD" BorderThickness="1" Padding="20">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="👈 Sélectionner une vente" FontSize="16" Foreground="#BBB" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Detail View -->
            <Border Background="White" BorderBrush="#DDD" BorderThickness="1" Padding="20"
                    Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Détail du Ticket" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="#2E7D32"/>
                    
                    <StackPanel Grid.Row="1" Margin="0,0,0,15">
                        <TextBlock Text="{Binding SelectedSale.NumeroTicket}" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedSale.CreatedAt, StringFormat='le {0:dd MMMM yyyy à HH:mm}'}" Foreground="#666"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                             <TextBlock Text="Statut: " Foreground="#666"/>
                             <TextBlock Text="{Binding SelectedSale.Statut}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Lignes -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding SelectedSale.Lignes}" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="White" BorderThickness="0" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Produit" Binding="{Binding ProduitNom}" Width="*"/>
                            <DataGridTextColumn Header="Qte" Binding="{Binding Quantite, StringFormat=N2}" Width="50"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalLigne, StringFormat=C}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="3" Margin="0,15,0,0">
                        <Border BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                     <TextBlock Text="Nb Articles:" Foreground="#666"/>
                                     <TextBlock Text="{Binding SelectedSale.NbArticles}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="En Espèces" FontSize="11" Foreground="#666"/>
                                        <TextBlock Text="{Binding SelectedSale.MontantEspeces, StringFormat=C}" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="Par Carte" FontSize="11" Foreground="#666"/>
                                        <TextBlock Text="{Binding SelectedSale.MontantCB, StringFormat=C}" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <TextBlock Text="Monnaie Rendue" FontSize="11" Foreground="#666"/>
                                        <TextBlock Text="{Binding SelectedSale.MonnaieRendue, StringFormat=C}" FontWeight="Bold" Foreground="OrangeRed"/>
                                    </StackPanel>
                                </Grid>
                                <DockPanel>
                                    <TextBlock Text="TOTAL TICKET" FontWeight="Bold" FontSize="18"/>
                                    <TextBlock Text="{Binding SelectedSale.Total, StringFormat=C}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Right" DockPanel.Dock="Right" Foreground="#2E7D32"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                             <Button Content="👁 Voir / Imprimer Ticket" Command="{Binding ViewTicketCommand}" 
                                     Background="#4CAF50" Foreground="White" Padding="15,10" Style="{StaticResource BaseButtonStyle}" Margin="0,0,10,0" HorizontalAlignment="Stretch" Width="230"/>
                             <Button Content="🖨 Réimprimer Direct" Command="{Binding ReprintCommand}" 
                                     Background="#1976D2" Foreground="White" Padding="15,10" Style="{StaticResource BaseButtonStyle}" HorizontalAlignment="Stretch" Width="230"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
