<UserControl x:Class="SystemeCaisse.UI.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SystemeCaisse.UI.Views"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <!-- Style pour les cartes produits -->
        <Style x:Key="ProductCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#DDDDDD" BlurRadius="5" ShadowDepth="2" Direction="270" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#BBBBBB" BlurRadius="10" ShadowDepth="4" Direction="270" Opacity="0.7"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Background" Value="#FAFAFA"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <!-- Section unique: Catalogue -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barre de recherche (AutoComplete Suggestions) -->
            <Border Grid.Row="0" Background="White" CornerRadius="20" Padding="15,5" Margin="0,0,0,20" BorderBrush="#EEEEEE" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="5,0,10,0" Foreground="Gray" FontSize="16"/>
                    
                    <ComboBox x:Name="searchCombo" Grid.Column="1" 
                              IsEditable="True" 
                              IsTextSearchEnabled="False"
                              IsTextSearchCaseSensitive="False"
                              StaysOpenOnEdit="True"
                              BorderThickness="0" 
                              VerticalAlignment="Center" 
                              FontSize="16" 
                              ItemsSource="{Binding SearchSuggestions}"
                              Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                              SelectedItem="{Binding SelectedSearchProduct}"
                              IsDropDownOpen="{Binding IsSearchDropDownOpen, Mode=TwoWay}"
                              Loaded="searchCombo_Loaded"
                              Foreground="#333">
                        <ComboBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ScanCommand}"/>
                        </ComboBox.InputBindings>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="550" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Product Image -->
                                    <Border Width="40" Height="40" CornerRadius="4" Background="#F8F8F8" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding FullImagePath, Converter={StaticResource PathToImage}}" Stretch="Uniform" Margin="2"/>
                                            <TextBlock Text="📦" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#CCC"
                                                       Visibility="{Binding FullImagePath, Converter={StaticResource InvertedNullToVis}}"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Nom}" FontWeight="Bold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="8,0,10,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PrixVente, StringFormat={}{0:C}}" Foreground="#2E7D32" FontWeight="Bold"/>
                                        <TextBlock Foreground="#777" Margin="2,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="/Unité"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TypeVente}" Value="poids">
                                                            <Setter Property="Text" Value="/kg"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Bouton Effacer -->
                    <Button Grid.Column="2" Content="✕" Command="{Binding ClearSearchCommand}" 
                            Background="Transparent" BorderThickness="0" Foreground="#999" FontSize="18" Padding="8" Cursor="Hand"
                            ToolTip="Effacer la recherche">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#D32F2F"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
 
            <!-- Liste des produits (Top 20 les plus vendus) -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,10">
                        <TextBlock Text="Top Produits" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <Button Content="" FontFamily="Segoe MDL2 Assets" Background="Transparent" BorderThickness="0" 
                                Foreground="#AAAAAA" Margin="10,0,0,0" ToolTip="Rafraîchir"
                                Command="{Binding CalculateProductPopularityCommand}"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding TopProducts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Left" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="160" Height="180" Margin="8" Style="{StaticResource ProductCardStyle}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" 
                                                  Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- Product Image (with fallback) -->
                                    <Border Grid.Row="0" Margin="5" CornerRadius="8" Background="#F8F8F8" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding FullImagePath, Converter={StaticResource PathToImage}}" Stretch="Uniform" Margin="5"/>
                                            <TextBlock Text="📦" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#CCCCCC"
                                                       Visibility="{Binding FullImagePath, Converter={StaticResource InvertedNullToVis}}"/>
                                        </Grid>
                                    </Border>
                                    <!-- Nom - Fixed Truncation with Wrapping -->
                                    <TextBlock Grid.Row="1" Text="{Binding Nom}" FontWeight="Bold" FontSize="13" 
                                               Margin="5,5,5,0" HorizontalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap" MaxHeight="45" VerticalAlignment="Top" Foreground="#333333"/>
                                    <!-- Prix -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,5">
                                        <TextBlock Text="{Binding PrixVente, StringFormat={}{0:C}}" FontSize="14" FontWeight="SemiBold" Foreground="#2E7D32"/>
                                        <TextBlock FontSize="11" Foreground="#777" VerticalAlignment="Bottom" Margin="2,0,0,1">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="/Unité"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TypeVente}" Value="poids">
                                                            <Setter Property="Text" Value="/kg"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
    </Grid>
</UserControl>
