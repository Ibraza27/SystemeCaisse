<UserControl x:Class="SystemeCaisse.UI.Views.PromotionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:SystemeCaisse.UI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:PromotionsViewModel}"
             d:DesignHeight="500" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🏷️ Gestion des Promotions" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Add New Promotion Form -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.1" Color="Gray"/>
            </Border.Effect>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="0,0,10,10">
                        <TextBlock Text="Nom de la promotion" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding NewNom}" Padding="8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,10">
                        <TextBlock Text="Type de promotion" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding PromotionTypes}" SelectedItem="{Binding NewTypePromotion}" Padding="5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,10,10">
                        <TextBlock Text="Début" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding NewDateDebut}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="0,0,10,10">
                        <TextBlock Text="Fin" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <CheckBox Content="Sans date de fin" IsChecked="{Binding IsIndeterminateEndDate}" Margin="0,0,0,5" FontSize="11" Foreground="#666"/>
                        <DatePicker SelectedDate="{Binding NewDateFin}" IsEnabled="{Binding IsIndeterminateEndDate, Converter={StaticResource BoolInverter}}"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,10"/>

                <Grid>
                    <Grid.Resources>
                        <Style TargetType="StackPanel">
                            <Setter Property="Margin" Value="0,0,15,10"/>
                        </Style>
                    </Grid.Resources>
                    <WrapPanel Orientation="Horizontal">
                        <!-- Target Selection (Product or Category) -->
                        <StackPanel Visibility="{Binding NewTypePromotion, Converter={StaticResource StringToVis}, ConverterParameter='remise_produit,quantite_offerte,remise_ieme,prix_degressif,offre_combine'}">
                            <TextBlock Text="Cibler un Produit" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding FilteredProduits}" 
                                      SelectedItem="{Binding NewSelectedProduit}" 
                                      Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                                      IsDropDownOpen="{Binding IsProductDropDownOpen, Mode=TwoWay}"
                                      IsTextSearchEnabled="False"
                                      IsEditable="True"
                                      TextSearch.TextPath="Nom" Width="250" Padding="5">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="25" Height="25" CornerRadius="4" Background="#F8F8F8" ClipToBounds="True" Margin="0,0,5,0">
                                                <Grid>
                                                    <Image Source="{Binding FullImagePath, Converter={StaticResource PathToImage}}" Stretch="Uniform" Margin="2"/>
                                                    <TextBlock Text="📦" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#CCC"
                                                               Visibility="{Binding FullImagePath, Converter={StaticResource InvertedNullToVis}}"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Nom}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Visibility="{Binding NewTypePromotion, Converter={StaticResource StringToVis}, ConverterParameter='remise_produit'}">
                            <TextBlock Text="Ou une Catégorie" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding NewSelectedCategorie}" Width="150" Padding="5"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding NewTypePromotion, Converter={StaticResource StringToVis}, ConverterParameter='remise_total,remise_produit,seuil_panier'}">
                            <TextBlock Text="Valeur Remise" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding NewValeur}" Width="70" Padding="8"/>
                                <RadioButton Content="%" IsChecked="{Binding NewIsPourcentage}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <RadioButton Content="€" IsChecked="{Binding NewIsPourcentage, Converter={StaticResource BoolInverter}}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Quantity specific -->
                        <StackPanel Visibility="{Binding NewTypePromotion, Converter={StaticResource StringToVis}, ConverterParameter='quantite_offerte'}">
                            <TextBlock Text="Seuil Qté" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding NewSeuilQuantite}" Width="70" Padding="8"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding NewTypePromotion, Converter={StaticResource StringToVis}, ConverterParameter='quantite_offerte'}">
                            <TextBlock Text="Qté Offerte" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding NewQuantiteOfferte}" Width="70" Padding="8"/>
                        </StackPanel>

                        <!-- Nth article remises -->
                        <StackPanel Visibility="{Binding NewTypePromotion, Converter={StaticResource StringToVis}, ConverterParameter='remise_ieme'}">
                            <TextBlock Text="Sur le N-ième article" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding NewIemeArticle}" Width="70" Padding="8"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding NewTypePromotion, Converter={StaticResource StringToVis}, ConverterParameter='remise_ieme'}">
                            <TextBlock Text="Remise" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding NewRemiseSurIeme}" Width="70" Padding="8"/>
                                <RadioButton Content="%" IsChecked="{Binding NewIsPourcentage}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <RadioButton Content="€" IsChecked="{Binding NewIsPourcentage, Converter={StaticResource BoolInverter}}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Basket Threshold -->
                        <StackPanel Visibility="{Binding NewTypePromotion, Converter={StaticResource StringToVis}, ConverterParameter='seuil_panier'}">
                            <TextBlock Text="À partir de (total panier)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding NewSeuilPanier}" Width="100" Padding="8"/>
                        </StackPanel>

                        <!-- Spécifique Offre Combinée (Bundle) -->
                        <StackPanel Visibility="{Binding NewTypePromotion, Converter={StaticResource StringToVis}, ConverterParameter='offre_combine'}">
                            <TextBlock Text="Lot de produits (Bundle) :" FontWeight="Bold" Margin="0,10,0,5"/>
                            <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="Qté:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBox Text="{Binding BundleItemQuantity}" Width="40" Padding="3" VerticalAlignment="Center"/>
                                        <Button Content="➕ Ajouter au lot" Command="{Binding AddBundleItemCommand}" 
                                                Margin="10,0,0,0" Padding="10,3" Background="#4CAF50" Foreground="White"/>
                                    </StackPanel>
                                    
                                    <ItemsControl ItemsSource="{Binding CurrentBundleItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F9F9F9" Margin="0,2" Padding="5" CornerRadius="3" BorderBrush="#EEE" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Produit.Nom}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding QuantiteRequise, StringFormat='x{0}'}" FontWeight="Bold" Margin="10,0"/>
                                                        <Button Grid.Column="2" Content="❌" Command="{Binding DataContext.RemoveBundleItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                                                CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="Red"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Prix Total du lot :" FontWeight="Bold" Margin="0,10,0,5"/>
                            <TextBox Text="{Binding NewValeur}" Width="100" HorizontalAlignment="Left" Padding="5"/>
                        </StackPanel>

                        <!-- Degresive Pricing Tiers -->
                        <StackPanel Visibility="{Binding NewTypePromotion, Converter={StaticResource StringToVis}, ConverterParameter='prix_degressif'}">
                            <TextBlock Text="Paliers de prix" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <ItemsControl ItemsSource="{Binding NewTiers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <TextBlock Text="Min Qté:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox Text="{Binding QuantiteMin}" Width="50" Padding="3"/>
                                            <TextBlock Text="Prix/U:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                            <TextBox Text="{Binding PrixUnitaire}" Width="60" Padding="3"/>
                                            <Button Command="{Binding DataContext.RemoveTierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}" Content="✕" Margin="5,0,0,0" Width="20" Background="Transparent" Foreground="Red" BorderThickness="0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Command="{Binding AddTierCommand}" Content="+ Ajouter un palier" Padding="5,2" Margin="0,5,0,0" Background="#EEE" Cursor="Hand"/>
                        </StackPanel>
                    </WrapPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <!-- Cancel Button (only visible when editing) -->
                    <Button Command="{Binding CancelEditCommand}" Padding="20,10" Background="#FF3B30" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold" Content="Annuler" Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <!-- Add/Update Button -->
                    <Button Command="{Binding AddPromotionCommand}" Padding="20,10" Background="#34C759" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="Ajouter la Promotion"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Content" Value="Mettre à jour la Promotion"/>
                                        <Setter Property="Background" Value="#007AFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Promotions List -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Promotions}" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" BorderThickness="0" RowHeight="35">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*"/>
                <DataGridTextColumn Header="Valeur" Binding="{Binding Valeur, StringFormat=N2}" Width="80"/>
                <DataGridTemplateColumn Header="Unité" Width="50">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding IsPourcentage, Converter={StaticResource BoolToUnitConverter}}" HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Début" Binding="{Binding DateDebut, StringFormat=d}" Width="100"/>
                <DataGridTemplateColumn Header="Fin" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding DateFin, StringFormat=d}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DateFin}" Value="{x:Null}">
                                                <Setter Property="Text" Value="Indéterminée"/>
                                                <Setter Property="FontStyle" Value="Italic"/>
                                                <Setter Property="Foreground" Value="#999"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTemplateColumn Header="Actif" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Actif, UpdateSourceTrigger=PropertyChanged}" 
                                      Command="{Binding DataContext.ToggleStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                      CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                             <StackPanel Orientation="Horizontal">
                                 <Button Command="{Binding DataContext.EditPromotionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                         CommandParameter="{Binding}" Content="Modif." Background="#007AFF" Foreground="White" BorderThickness="0" Padding="5,2" Margin="0,0,5,0"/>
                                 <Button Command="{Binding DataContext.DeletePromotionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                         CommandParameter="{Binding}" Content="Suppr." Background="#FF3B30" Foreground="White" BorderThickness="0" Padding="5,2"/>
                             </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
