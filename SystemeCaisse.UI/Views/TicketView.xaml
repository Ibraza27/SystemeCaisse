<UserControl x:Class="SystemeCaisse.UI.Views.TicketView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="400">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- List -->
            <RowDefinition Height="Auto"/> <!-- Totals -->
            <RowDefinition Height="Auto"/> <!-- Actions -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Ticket en cours" FontSize="24" FontWeight="Bold" Foreground="#333"/>
                <TextBlock Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Foreground="#777"/>
            </StackPanel>

            <!-- Suspended Sales Resume Section -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SuspendedSales.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                
                <ComboBox x:Name="cbSuspended" ItemsSource="{Binding SuspendedSales}" Width="130" Margin="0,0,5,0"
                          Height="30" VerticalContentAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="📂" Command="{Binding ResumeSaleCommand}" CommandParameter="{Binding ElementName=cbSuspended, Path=SelectedItem}"
                        Background="#FFF8E1" Foreground="#F57F17" BorderThickness="0" Width="30" Height="30">
                     <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Cart List -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Panier}" AutoGenerateColumns="False" CanUserAddRows="False" 
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0"
                  SelectionMode="Single" SelectedItem="{Binding SelectedCartItem}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Produit" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Margin="5">
                                <TextBlock Text="{Binding ProduitNom}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding PromotionAppliquee}" Foreground="#2E7D32" FontSize="11" FontStyle="Italic"
                                           Visibility="{Binding PromotionAppliquee, Converter={StaticResource StringToVisibilityConverter}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTemplateColumn Header="P.U" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PrixUnitaire, StringFormat={}{0:C}}" FontSize="12"/>
                                <TextBlock FontSize="10" Foreground="Gray" VerticalAlignment="Bottom" Margin="2,0,0,1">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="/u"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Produit.TypeVente}" Value="poids">
                                                    <Setter Property="Text" Value="/kg"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Qté" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="-" Command="{Binding DecreaseQuantityCommand}" Width="25" Height="25"/>
                                <TextBlock Text="{Binding Quantite}" Width="35" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold">
                                    <TextBlock.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick" 
                                                      Command="{Binding DataContext.EditQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                      CommandParameter="{Binding}"/>
                                    </TextBlock.InputBindings>
                                </TextBlock>
                                <Button Content="+" Command="{Binding IncreaseQuantityCommand}" Width="25" Height="25"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Total" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TotalLigneStandard, StringFormat={}{0:C}}" 
                                           TextDecorations="Strikethrough" Foreground="Gray" FontSize="11"
                                           Visibility="{Binding HasPromotion, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='True'}"
                                           HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding TotalLigne, StringFormat={}{0:C}}" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTemplateColumn Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="❌" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                    CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Foreground="Red"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Totals & Payments -->
        <StackPanel Grid.Row="2" Margin="0,10">
            <Separator Background="#EEE" Margin="0,0,0,10"/>
            
            <Grid Margin="0,0,0,5" Visibility="{Binding TotalRemise, Converter={StaticResource StringToVisibilityConverter}}">
                <TextBlock Text="Total hors remise" FontSize="14" Foreground="Gray"/>
                <TextBlock Text="{Binding TotalSansRemise, StringFormat={}{0:C}}" FontSize="14" FontWeight="Bold" Foreground="Gray" HorizontalAlignment="Right"/>
            </Grid>

            <Grid Margin="0,0,0,5" Visibility="{Binding TotalRemise, Converter={StaticResource StringToVisibilityConverter}}">
                <TextBlock Text="Total Remise" FontSize="14" Foreground="#C62828"/>
                <TextBlock Text="{Binding TotalRemise, StringFormat={}-{0:C}}" FontSize="14" FontWeight="Bold" Foreground="#C62828" HorizontalAlignment="Right"/>
            </Grid>

            <Border Background="#E8F5E9" CornerRadius="8" Padding="15" Margin="0,5,0,10">
                <Grid>
                    <TextBlock Text="Total à payer" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#2E7D32"/>
                    <TextBlock Text="{Binding Total, StringFormat={}{0:C}}" FontSize="32" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- Mode Payment Buttons -->
            <UniformGrid Columns="3" Margin="0,0,0,10">
                <Button Content="💵 Cash" Command="{Binding PaymentModeCommand}" CommandParameter="Especes" Height="45" Margin="0,0,5,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#EEE"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPaiementMode}" Value="Especes">
                                    <Setter Property="Background" Value="#2E7D32"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="💳 CB" Command="{Binding PaymentModeCommand}" CommandParameter="CB" Height="45" Margin="5,0,5,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#EEE"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPaiementMode}" Value="CB">
                                    <Setter Property="Background" Value="#1565C0"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="🔀 Mixte" Command="{Binding PaymentModeCommand}" CommandParameter="Mixte" Height="45" Margin="5,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#EEE"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPaiementMode}" Value="Mixte">
                                    <Setter Property="Background" Value="#E65100"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </UniformGrid>
            
            <!-- Cash Details -->
            <StackPanel Margin="0,5">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedPaiementMode}" Value="Especes">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedPaiementMode}" Value="Mixte">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                
                <Grid Margin="0,5">
                    <TextBlock Text="Reçu :" VerticalAlignment="Center" FontSize="14"/>
                    <TextBox Text="{Binding MontantRecu, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" 
                             Width="100" HorizontalAlignment="Right" FontSize="20" FontWeight="Bold"/>
                </Grid>

                <Grid Margin="0,5">
                    <Grid.Style>
                        <Style TargetType="Grid">
                             <Setter Property="Visibility" Value="Collapsed"/>
                             <Style.Triggers>
                                 <DataTrigger Binding="{Binding SelectedPaiementMode}" Value="Especes">
                                     <Setter Property="Visibility" Value="Visible"/>
                                 </DataTrigger>
                             </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <TextBlock Text="À Rendre :" VerticalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="{Binding MonnaieRendre, StringFormat={}{0:C}}" 
                               FontSize="24" FontWeight="Bold" Foreground="Blue" HorizontalAlignment="Right"/>
                </Grid>

                <Grid Margin="0,5">
                    <Grid.Style>
                        <Style TargetType="Grid">
                             <Setter Property="Visibility" Value="Collapsed"/>
                             <Style.Triggers>
                                 <DataTrigger Binding="{Binding SelectedPaiementMode}" Value="Mixte">
                                     <Setter Property="Visibility" Value="Visible"/>
                                 </DataTrigger>
                             </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <TextBlock Text="Reste CB :" VerticalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="{Binding MontantCarte, StringFormat={}{0:C}}" 
                               FontSize="24" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </StackPanel>

        <!-- Actions -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <UniformGrid Columns="3" Margin="0,0,0,10">
                <Button Content="🗑️ VIDER" Command="{Binding ViderPanierCommand}" Height="45" Margin="0,0,5,0" ToolTip="Vider le panier" Background="#FFEBEE" Foreground="#C62828" FontWeight="Bold"/>
                <Button Content="🏷️ REMISE" Command="{Binding OpenDiscountDialogCommand}" Height="45" Margin="5,0,5,0" ToolTip="Remise"/>
                <Button Content="📂 ATTENTE" Command="{Binding SuspendSaleCommand}" Height="45" Margin="5,0,0,0" ToolTip="Attente"/>
            </UniformGrid>
            <Button Grid.Row="1" Content="VALIDER" Command="{Binding CheckoutCommand}" Height="60" Background="#2E7D32" Foreground="White" FontSize="22" FontWeight="Bold">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</UserControl>
