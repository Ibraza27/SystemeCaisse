<Window x:Class="SystemeCaisse.UI.Views.TPEPaymentErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Erreur de Paiement TPE" 
        SizeToContent="WidthAndHeight"
        MinWidth="420" MaxWidth="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="#FAFAFA">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Icône et titre -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="❌" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="Paiement Refusé" FontSize="22" FontWeight="Bold" Foreground="#C62828" 
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Message d'erreur -->
        <Border Grid.Row="1" Background="#FFEBEE" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <TextBlock x:Name="ErrorMessageText" Text="Erreur inconnue" 
                       FontSize="14" Foreground="#B71C1C" TextWrapping="Wrap" TextAlignment="Center"/>
        </Border>

        <!-- Montant -->
        <Border Grid.Row="2" Background="#FFF3E0" CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <Grid>
                <TextBlock Text="Montant à débiter" FontSize="14" Foreground="#E65100" VerticalAlignment="Center"/>
                <TextBlock x:Name="AmountText" Text="0,00 €" FontSize="22" FontWeight="Bold" 
                           Foreground="#E65100" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Info -->
        <TextBlock Grid.Row="3" Text="Vous pouvez réessayer le paiement sur le TPE ou annuler pour revenir à la caisse."
                   FontSize="12" Foreground="#888" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>

        <!-- Boutons -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Bouton Réessayer -->
            <Button Grid.Column="0" Content="🔄 Réessayer" Click="Retry_Click"
                    Height="50" FontSize="16" FontWeight="Bold"
                    Background="#1565C0" Foreground="White" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

            <!-- Bouton Annuler -->
            <Button Grid.Column="2" Content="❌ Annuler" Click="Cancel_Click"
                    Height="50" FontSize="16" FontWeight="Bold"
                    Background="#757575" Foreground="White" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
