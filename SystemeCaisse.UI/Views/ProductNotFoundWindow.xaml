<Window x:Class="SystemeCaisse.UI.Views.ProductNotFoundWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Produit non trouvé" Height="250" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#FFF9C4">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="⚠️ Produit Non Référencé" FontSize="20" FontWeight="Bold" Foreground="#F57F17" HorizontalAlignment="Center"/>
        
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="Le code barre suivant n'est pas dans la base :" HorizontalAlignment="Center" Margin="0,10,0,5"/>
            <TextBlock x:Name="TxtCode" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#333"/>
        </StackPanel>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="Fermer" IsCancel="True" Width="100" Height="40" Margin="0,0,10,0" Background="White"/>
            <Button Content="➕ AJOUTER" Click="BtnAdd_Click" Width="150" Height="40" Background="#F57F17" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
