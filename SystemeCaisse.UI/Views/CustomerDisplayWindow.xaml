<Window x:Class="SystemeCaisse.UI.Views.CustomerDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:SystemeCaisse.UI.ViewModels"
        xmlns:conv="clr-namespace:SystemeCaisse.UI.Converters"
        mc:Ignorable="d"
        Title="Hippocampe - Affichage Client v3.2" Height="1080" Width="1920"
        WindowStyle="None" Background="#F2F2F7">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding CartColumnWidth}"/>
            <ColumnDefinition>
                <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                        <Setter Property="Width" Value="1.2*"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowDisplayPromotions}" Value="False">
                                <Setter Property="Width" Value="0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
        </Grid.ColumnDefinitions>

        <!-- Left Column: Cart Info -->
        <Grid Grid.Column="0" Background="White" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: NORMAL mode -->
            <Border Background="White" BorderBrush="#EEE" BorderThickness="0,0,0,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Padding" Value="20,15"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompactCustomerDisplay}" Value="True">
                                <Setter Property="Padding" Value="8,6"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Logo: smaller in compact -->
                    <Image Source="{Binding CurrentEntreprise.LogoPath, TargetNullValue='pack://application:,,,/Images/logo.png', FallbackValue='pack://application:,,,/Images/logo.png'}" 
                           Stretch="Uniform" VerticalAlignment="Top">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Width" Value="140"/>
                                <Setter Property="Height" Value="110"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompactCustomerDisplay}" Value="True">
                                        <Setter Property="Width" Value="70"/>
                                        <Setter Property="Height" Value="55"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Margin" Value="30,0,0,0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompactCustomerDisplay}" Value="True">
                                        <Setter Property="Margin" Value="10,0,0,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <!-- Enterprise Name -->
                        <TextBlock Text="{Binding CurrentEntreprise.Nom, FallbackValue='HIPPOCAMPE'}" FontWeight="Black" Foreground="#2E7D32" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="36"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompactCustomerDisplay}" Value="True">
                                            <Setter Property="FontSize" Value="18"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Address -->
                        <TextBlock Text="{Binding CurrentEntreprise.Adresse}" Foreground="#555" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="16"/>
                                    <Setter Property="Margin" Value="0,5,0,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompactCustomerDisplay}" Value="True">
                                            <Setter Property="FontSize" Value="10"/>
                                            <Setter Property="Margin" Value="0,2,0,0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Horaires -->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Margin" Value="0,5,0,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompactCustomerDisplay}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding CurrentEntreprise.HorairesSemaine}" FontSize="14" Foreground="#777" FontWeight="Bold" 
                                       Visibility="{Binding CurrentEntreprise.HorairesSemaine, Converter={StaticResource StringToVis}}"/>
                            <TextBlock Text="  |  " FontSize="14" Foreground="#CCC">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding CurrentEntreprise.HorairesSemaine, Converter={StaticResource StringToBool}}" Value="True"/>
                                                    <Condition Binding="{Binding CurrentEntreprise.HorairesDimanche, Converter={StaticResource StringToBool}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding CurrentEntreprise.HorairesDimanche}" FontSize="14" Foreground="#777" FontWeight="Bold"
                                       Visibility="{Binding CurrentEntreprise.HorairesDimanche, Converter={StaticResource StringToVis}}"/>
                        </StackPanel>
                        <!-- Phone -->
                        <TextBlock Text="{Binding CurrentEntreprise.Telephone}" FontWeight="Bold" Foreground="#333">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="18"/>
                                    <Setter Property="Margin" Value="0,5,0,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompactCustomerDisplay}" Value="True">
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="Margin" Value="0,2,0,0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <!-- Date -->
                        <TextBlock Text="{Binding CurrentDate}" Foreground="#666" HorizontalAlignment="Right">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="24"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompactCustomerDisplay}" Value="True">
                                            <Setter Property="FontSize" Value="13"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Time -->
                        <TextBlock Text="{Binding CurrentTime}" Foreground="#333" FontWeight="Black" HorizontalAlignment="Right" Margin="0,2,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="32"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompactCustomerDisplay}" Value="True">
                                            <Setter Property="FontSize" Value="16"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- VOTRE PANIER label -->
                        <TextBlock Text="VOTRE PANIER" Foreground="#999" FontWeight="Black" HorizontalAlignment="Right">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="18"/>
                                    <Setter Property="Margin" Value="0,10,0,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompactCustomerDisplay}" Value="True">
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="Margin" Value="0,4,0,0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Items List: NORMAL MODE -->
            <ListView x:Name="CartListView" Grid.Row="1" ItemsSource="{Binding LignesVente}" Margin="0,10" BorderThickness="0" FontFamily="Segoe UI">
                <ListView.Style>
                    <Style TargetType="ListView">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompactCustomerDisplay}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.Style>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="45" Height="45" CornerRadius="4" Background="#F8F8F8" ClipToBounds="True" Margin="0,2">
                                        <Grid>
                                            <Image Source="{Binding Produit.FullImagePath, Converter={StaticResource PathToImage}}" Stretch="Uniform" Margin="2"/>
                                            <TextBlock Text="📦" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#CCC"
                                                       Visibility="{Binding Produit.FullImagePath, Converter={StaticResource InvertedNullToVis}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Produit" Width="300">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Produit.Nom}" FontSize="22" FontWeight="SemiBold" Margin="5"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Qté" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Quantite, StringFormat={}{0:N2}}" FontSize="22" Margin="5"/>
                                        <TextBlock FontSize="12" Foreground="Gray" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="u"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Produit.TypeVente}" Value="poids">
                                                            <Setter Property="Text" Value="kg"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="P.U" Width="140">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PrixUnitaire, StringFormat='{}{0:N2} €'}" FontSize="20" TextAlignment="Right" Margin="5"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Remise" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock Text="{Binding RemiseTotale, StringFormat='{}{0:N2} €'}" FontSize="20" Foreground="#D32F2F" FontWeight="Bold" Visibility="{Binding HasPromotion, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="-" HorizontalAlignment="Center" FontSize="20" Visibility="{Binding HasPromotion, Converter={StaticResource InvertedBoolToVis}}"/>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Total" Width="180">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding TotalLigneStandard, StringFormat='{}{0:N2}'}" FontSize="16" Foreground="#999" TextDecorations="Strikethrough" Visibility="{Binding HasPromotion, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding TotalLigne, StringFormat='{}{0:N2} €'}" FontSize="24" FontWeight="Bold" Foreground="#2E7D32" TextAlignment="Right"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Items List: COMPACT MODE (tighter columns, no horizontal scroll) -->
            <ListView x:Name="CartListViewCompact" Grid.Row="1" ItemsSource="{Binding LignesVente}" Margin="0,2" BorderThickness="0" FontFamily="Segoe UI"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.Style>
                    <Style TargetType="ListView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompactCustomerDisplay}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.Style>
                <ListView.View>
                    <GridView>
                        <!-- Hide the empty trailing column header -->
                        <GridView.ColumnHeaderContainerStyle>
                            <Style TargetType="GridViewColumnHeader">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <Trigger Property="Column" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </GridView.ColumnHeaderContainerStyle>
                        <GridViewColumn Width="45">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="35" Height="35" CornerRadius="4" Background="#F8F8F8" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding Produit.FullImagePath, Converter={StaticResource PathToImage}}" Stretch="Uniform" Margin="2"/>
                                            <TextBlock Text="📦" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#CCC"
                                                       Visibility="{Binding Produit.FullImagePath, Converter={StaticResource InvertedNullToVis}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Produit" Width="260">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Produit.Nom}" FontSize="12" FontWeight="SemiBold" Margin="1" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Qté" Width="65">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Quantite, StringFormat={}{0:N2}}" FontSize="12" Margin="1"/>
                                        <TextBlock FontSize="9" Foreground="Gray" VerticalAlignment="Bottom" Margin="2,0,0,2">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="u"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Produit.TypeVente}" Value="poids">
                                                            <Setter Property="Text" Value="kg"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="P.U" Width="65">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PrixUnitaire, StringFormat='{}{0:N2} €'}" FontSize="12" TextAlignment="Right" Margin="1"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Rem." Width="55">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock Text="{Binding RemiseTotale, StringFormat='{}{0:N2} €'}" FontSize="12" Foreground="#D32F2F" FontWeight="Bold" Visibility="{Binding HasPromotion, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="-" HorizontalAlignment="Center" FontSize="12" Visibility="{Binding HasPromotion, Converter={StaticResource InvertedBoolToVis}}"/>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Total" Width="75">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TotalLigne, StringFormat='{}{0:N2} €'}" FontSize="13" FontWeight="Bold" Foreground="#2E7D32" TextAlignment="Right" Margin="1"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>


            <!-- Summary Footer -->
            <Border Grid.Row="2" Background="#F5F5F7" CornerRadius="0,0,10,10" BorderBrush="#DDD" BorderThickness="0,1,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Padding" Value="25"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompactCustomerDisplay}" Value="True">
                                <Setter Property="Padding" Value="10,6"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel VerticalAlignment="Center">
                        <!-- NORMAL: Total Brut and Remises stacked vertically -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompactCustomerDisplay}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="Total Brut:" FontSize="22" Foreground="#666" Width="180"/>
                                <TextBlock Text="{Binding TotalHorsRemise, StringFormat='{}{0:N2} €'}" FontSize="22" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Total Remises:" FontSize="22" Foreground="#D32F2F" Width="180"/>
                                <TextBlock Text="{Binding TotalRemises, StringFormat='{}- {0:N2} €'}" FontSize="22" FontWeight="Bold" Foreground="#D32F2F"/>
                            </StackPanel>
                            <Border Height="2" Background="#DDD" Margin="0,5"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                                <TextBlock Text="TOTAL À PAYER" FontSize="40" FontWeight="Black" Foreground="#333" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- COMPACT: Brut and Remises on same line, "Total :" label -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompactCustomerDisplay}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="Brut:" FontSize="13" Foreground="#666" Width="80"/>
                                <TextBlock Text="{Binding TotalHorsRemise, StringFormat='{}{0:N2} €'}" FontSize="13" FontWeight="SemiBold" Margin="0,0,20,0"/>
                                <TextBlock Text="Remises:" FontSize="13" Foreground="#D32F2F"/>
                                <TextBlock Text="{Binding TotalRemises, StringFormat='{} -{0:N2} €'}" FontSize="13" FontWeight="Bold" Foreground="#D32F2F" Margin="5,0,0,0"/>
                            </StackPanel>
                            <Border Height="1" Background="#DDD" Margin="0,2"/>
                            <TextBlock Text="Total :" FontSize="22" FontWeight="Black" Foreground="#333" VerticalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalVente, StringFormat='{}{0:N2} €'}" 
                                   FontWeight="Black" Foreground="#2E7D32" 
                                   TextAlignment="Right">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="84"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompactCustomerDisplay}" Value="True">
                                            <Setter Property="FontSize" Value="40"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Right Column: Media / Promotions -->
        <Grid Grid.Column="1" Visibility="{Binding ShowDisplayPromotions, Converter={StaticResource BoolToVis}}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Margin" Value="0,20,20,20"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompactCustomerDisplay}" Value="True">
                            <Setter Property="Margin" Value="0,8,8,8"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Ad Carousel / Image -->
            <Border Grid.Row="0" Background="#222" CornerRadius="10" ClipToBounds="True">
                <Grid>
                    <Image x:Name="AdImage" Stretch="UniformToFill" 
                           Source="{Binding CurrentEntreprise.LogoPath, TargetNullValue='pack://application:,,,/Images/logo.png', FallbackValue='pack://application:,,,/Images/logo.png'}" 
                           Opacity="0.4"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- Default text when no promotion is active -->
                        <StackPanel Visibility="{Binding CurrentDisplayPromotion, Converter={StaticResource InvertedNullToVis}}">
                            <TextBlock Text="{Binding CurrentEntreprise.Nom, FallbackValue='VOTRE MAGASIN'}" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="48"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCompactCustomerDisplay}" Value="True">
                                                <Setter Property="FontSize" Value="22"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="IMPORT-EXPORT" Foreground="#CCC" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="28"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCompactCustomerDisplay}" Value="True">
                                                <Setter Property="FontSize" Value="14"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- Active Promotion Display -->
                        <StackPanel Visibility="{Binding CurrentDisplayPromotion, Converter={StaticResource NullToVis}}">
                            <Border Background="#2E7D32" CornerRadius="30" HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Padding" Value="30,15"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCompactCustomerDisplay}" Value="True">
                                                <Setter Property="Padding" Value="15,6"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="🌟 OFFRE SPÉCIALE" FontWeight="Bold" Foreground="White">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="24"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompactCustomerDisplay}" Value="True">
                                                    <Setter Property="FontSize" Value="14"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <!-- Product Images Layout (Single or Bundle) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,5">
                                <!-- Normal Product Image -->
                                <Border CornerRadius="10" Width="120" Height="120" Background="#33FFFFFF" ClipToBounds="True">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompactCustomerDisplay}" Value="True">
                                                    <Setter Property="Width" Value="60"/>
                                                    <Setter Property="Height" Value="60"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentDisplayPromotion.TypePromotion}" Value="offre_combine">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentDisplayPromotion.TypePromotion}" Value="remise_total">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentDisplayPromotion.TypePromotion}" Value="seuil_panier">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Image Source="{Binding CurrentDisplayPromotion.Produit.FullImagePath, Converter={StaticResource PathToImage}}" Stretch="Uniform" Margin="5"/>
                                        <TextBlock Text="📦" FontSize="60" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#CCC">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentDisplayPromotion.Produit.FullImagePath}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- Bundle Items Images (visible ONLY if offre_combine) -->
                                <ItemsControl ItemsSource="{Binding CurrentDisplayPromotion.BundleItems}">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentDisplayPromotion.TypePromotion}" Value="offre_combine">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Width="120" Height="120" Background="#33FFFFFF" Margin="0,0,10,0" ClipToBounds="True">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsCompactCustomerDisplay, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                <Setter Property="Width" Value="60"/>
                                                                <Setter Property="Height" Value="60"/>
                                                                <Setter Property="Margin" Value="0,0,5,0"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Image Source="{Binding Produit.FullImagePath, Converter={StaticResource PathToImage}}" Stretch="Uniform" Margin="5"/>
                                                    <TextBlock Text="📦" FontSize="60" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#CCC">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Produit.FullImagePath}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock Text="{Binding CurrentDisplayPromotion.Nom}" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="42"/>
                                        <Setter Property="Margin" Value="0,20,0,10"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCompactCustomerDisplay}" Value="True">
                                                <Setter Property="FontSize" Value="20"/>
                                                <Setter Property="Margin" Value="0,8,0,4"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding CurrentDisplayPromotion.Valeur, StringFormat='{}{0:0.##} €'}" FontWeight="Black" Foreground="#FFD700" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="56"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCompactCustomerDisplay}" Value="True">
                                                <Setter Property="FontSize" Value="28"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentDisplayPromotion.IsPourcentage}" Value="True">
                                                <Setter Property="Text" Value="{Binding CurrentDisplayPromotion.Valeur, StringFormat='{}- {0:0.##} %'}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Welcome Message -->
            <Border Grid.Row="1" Background="White" CornerRadius="10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Margin" Value="0,20,0,0"/>
                        <Setter Property="Padding" Value="30"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompactCustomerDisplay}" Value="True">
                                <Setter Property="Margin" Value="0,6,0,0"/>
                                <Setter Property="Padding" Value="10,6"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Bienvenue chez" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#666">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="20"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompactCustomerDisplay}" Value="True">
                                        <Setter Property="FontSize" Value="12"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding CurrentEntreprise.Nom, FallbackValue='NOUS'}" FontWeight="Black" HorizontalAlignment="Center" Foreground="#2E7D32" TextWrapping="Wrap" TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="28"/>
                                <Setter Property="Margin" Value="0,5,0,0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompactCustomerDisplay}" Value="True">
                                        <Setter Property="FontSize" Value="15"/>
                                        <Setter Property="Margin" Value="0,2,0,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="Nous sommes à votre service !" Foreground="#666" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="18"/>
                                <Setter Property="Margin" Value="0,10,0,0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompactCustomerDisplay}" Value="True">
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Margin" Value="0,3,0,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Thank You Overlay -->
        <Border Grid.ColumnSpan="2" Background="#F2F2F7" Visibility="{Binding ShowThankYouMessage, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="{Binding CurrentEntreprise.LogoPath, TargetNullValue='pack://application:,,,/Images/logo.png', FallbackValue='pack://application:,,,/Images/logo.png'}" 
                       Width="250" Height="250" Margin="0,0,0,40"/>
                <TextBlock Text="MERCI DE VOTRE CONFIANCE !" FontSize="64" FontWeight="Black" Foreground="#2E7D32" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding CurrentEntreprise.Nom, FallbackValue='NOTRE MAGASIN'}" FontSize="42" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" Margin="0,20,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="À très bientôt ! 😊" FontSize="28" Foreground="#666" HorizontalAlignment="Center" Margin="0,15,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
