<UserControl x:Class="SystemeCaisse.UI.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:glob="clr-namespace:System.Globalization;assembly=mscorlib"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:SystemeCaisse.UI.ViewModels"
             xmlns:conv="clr-namespace:SystemeCaisse.UI.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:ProductsViewModel}"
             Language="fr-FR"
             d:DesignHeight="700" d:DesignWidth="1200">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:InvertedNullToVisibilityConverter x:Key="InvertedNullToVis"/>
        
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FAFAFA"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0078D7"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F0F0F0" Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="450"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Product List -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Filters Bar -->
            <Border Background="White" Padding="10" Margin="0,0,0,10" CornerRadius="4" BorderBrush="#DDD" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Rechercher :" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                    <Grid Width="220" Margin="0,0,20,0">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="5,5,25,5" VerticalContentAlignment="Center"/>
                        <Button Content="✕" Command="{Binding ClearSearchCommand}" 
                                HorizontalAlignment="Right" VerticalAlignment="Center" 
                                Width="20" Height="20" Margin="0,0,5,0"
                                Background="Transparent" BorderThickness="0" Foreground="#AAA" Cursor="Hand"
                                Visibility="{Binding SearchText.Length, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                    </Grid>

                    <TextBlock Text="Catégorie :" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategoryFilter}" Width="150" Padding="5" Margin="0,0,20,0"/>

                    <CheckBox Content="Actifs" IsChecked="{Binding ShowActive}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox Content="Inactifs" IsChecked="{Binding ShowInactive}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            
            <!-- DataGrid -->
            <DataGrid Grid.Row="1" ItemsSource="{Binding ProductsCollectionView}" 
                      SelectedItem="{Binding SelectedProduct}"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      AlternationCount="2"
                      RowHeight="55"
                      Background="White" BorderBrush="#DDD" BorderThickness="1">
                <DataGrid.Resources>
                     <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Background" Value="#EEEEEE"/>
                        <Setter Property="FontWeight" Value="bold"/>
                        <Setter Property="BorderBrush" Value="#DDD"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="5,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="0" Background="Transparent">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Code Barres" Binding="{Binding CodeBarre}" Width="110"/>
                    <DataGridTemplateColumn Header="Image" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Image Source="{Binding FullImagePath, Converter={StaticResource PathToImage}}" Width="45" Height="45" Stretch="Uniform" 
                                           Visibility="{Binding FullImagePath, Converter={StaticResource NullToVis}}"/>
                                    <TextBlock Text="📷" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#CCC"
                                               Visibility="{Binding FullImagePath, Converter={StaticResource InvertedNullToVis}}"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Nom du produit" Binding="{Binding Nom}" Width="*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding TypeVente}" Width="80"/>
                    <DataGridTextColumn Header="Prix Vente" Binding="{Binding PrixVente, StringFormat=C}" Width="90"/>
                    <DataGridTextColumn Header="Prix Achat" Binding="{Binding PrixAchat, StringFormat=C}" Width="90"/>
                    <DataGridTextColumn Header="Stock" Binding="{Binding StockActuel}" Width="70"/>
                    <DataGridTextColumn Header="Catégorie" Binding="{Binding Categorie}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Footer Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Command="{Binding AddCommand}" Content="Nouveau" Width="100" Padding="8" Background="#DDD" Margin="0,0,10,0" FontWeight="Bold"/>
                <Button Command="{Binding RefreshProductsCommand}" Content="🔄 Actualiser" Padding="8,8" Background="#1565C0" Foreground="White" Margin="0,0,10,0" FontWeight="SemiBold" ToolTip="Recharger les produits depuis la base de données">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                </Button>

                <TextBlock Text="{Binding ProductsCollectionView.Count, StringFormat='{}{0} produits'}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#666"/>
            </StackPanel>
        </Grid>

        <!-- Right: Detail Form -->
        <Border Grid.Column="2" Background="White" BorderBrush="#DDD" BorderThickness="1" Padding="20" 
                Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Informations produit" FontSize="16" FontWeight="Bold" Margin="0,0,0,20" Foreground="#333"/>
                    
                    <Label Content="Code-barres :"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SelectedProduct.CodeBarre, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                        <Button Grid.Column="1" Command="{Binding GenerateBarcodeCommand}" Content="Générer" Padding="10,2" Margin="5,0,0,0"/>
                    </Grid>

                    <Label Content="Nom du produit *:"/>
                    <TextBox Text="{Binding SelectedProduct.Nom, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,0,0,10"/>

                    <Label Content="Type de vente *:"/>
                    <ComboBox SelectedValue="{Binding SelectedProduct.TypeVente}" SelectedValuePath="Tag" Padding="5" Margin="0,0,0,10">
                        <ComboBoxItem Content="À l'unité" Tag="unite"/>
                        <ComboBoxItem Content="Au poids (kg)" Tag="poids"/>
                    </ComboBox>

                    <Label Content="Prix de vente (€) *:"/>
                    <TextBox Text="{Binding SelectedProduct.PrixVente, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:N2}'}" 
                             PreviewKeyDown="PriceTextBox_PreviewKeyDown"
                             GotFocus="PriceTextBox_GotFocus"
                             Padding="5" Margin="0,0,0,10"/>

                    <Label Content="Prix d'achat (€) :"/>
                    <TextBox Text="{Binding SelectedProduct.PrixAchat, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:N2}'}" 
                             PreviewKeyDown="PriceTextBox_PreviewKeyDown"
                             GotFocus="PriceTextBox_GotFocus"
                             Padding="5" Margin="0,0,0,10"/>

                    <Label Content="Palier de Taxe Alimentaire *:"/>
                    <ComboBox SelectedValue="{Binding SelectedProduct.TaxTier}" SelectedValuePath="Tag" Padding="5" Margin="0,0,0,10">
                        <ComboBoxItem Content="T1 - 5.5% (Défaut)" Tag="1"/>
                        <ComboBoxItem Content="T2 - 10%" Tag="2"/>
                        <ComboBoxItem Content="T3 - 20%" Tag="3"/>
                    </ComboBox>

                    <Label Content="Catégorie :"/>
                    <Grid Margin="0,0,0,10">
                         <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox IsEditable="True" 
                                  Text="{Binding SelectedProduct.Categorie, UpdateSourceTrigger=LostFocus}"
                                  ItemsSource="{Binding EditCategories}" Padding="5"/>
                        <Button Grid.Column="1" ToolTip="Effacer pour saisir une nouvelle catégorie" Content="➕" Width="30" Margin="5,0,0,0"
                                Command="{Binding ClearCategoryCommand}"/>
                        <!-- Simple CodeBehind/Event is tricky in MVVM pure view. I'll just skip the button logic and rely on IsEditable. 
                             Or bind Command that clears category. -->
                    </Grid>
                    
                    <Label Content="Stock actuel :"/>
                    <TextBox Text="{Binding SelectedProduct.StockActuel, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,0,0,10"/>

                    <Label Content="Stock d'alerte :"/>
                    <TextBox Text="{Binding SelectedProduct.StockAlerte, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,0,0,10"/>

                    <Label Content="Fournisseur :"/>
                    <ComboBox ItemsSource="{Binding Fournisseurs}" 
                              SelectedValue="{Binding SelectedProduct.FournisseurId}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Nom"
                              Padding="5" Margin="0,0,0,10"/>

                    <CheckBox IsChecked="{Binding SelectedProduct.Actif}" Content="Produit actif" Margin="0,10,0,10"/>

                    <!-- Product Image Section -->
                    <Label Content="Image du produit :"/>
                    <Border Background="#F8F8F8" CornerRadius="8" Padding="10" Margin="0,0,0,10" BorderBrush="#DDD" BorderThickness="1" MinHeight="80">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Preview -->
                            <Border Background="White" CornerRadius="4" Width="70" Height="70">
                                <Grid>
                                    <Image Source="{Binding SelectedProduct.FullImagePath, Converter={StaticResource PathToImage}}" Stretch="Uniform" Margin="3"/>
                                    <TextBlock Text="📷" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#CCC"
                                               Visibility="{Binding SelectedProduct.FullImagePath, Converter={StaticResource InvertedNullToVis}}"/>
                                </Grid>
                            </Border>
                            <!-- Buttons -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                <Button Command="{Binding SelectProductImageCommand}" Content="📁 Choisir une image" Padding="8,5" Margin="0,0,0,5" Background="#007AFF" Foreground="White" FontWeight="SemiBold"/>
                                <Button Command="{Binding RemoveProductImageCommand}" Content="🗑️ Supprimer" Padding="8,5" Background="#FF3B30" Foreground="White" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Command="{Binding SaveCommand}" Content="Enregistrer" Padding="15,8" Background="#4CAF50" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
                        <Button Command="{Binding DeleteCommand}" Content="Supprimer" Padding="15,8" Background="#F44336" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                    
                    <StackPanel x:Name="CsvButtons" Orientation="Horizontal" Margin="0,30,0,0">
                         <Button Content="Importer CSV" Padding="10,5" Margin="0,0,10,0"/>
                         <Button Content="Exporter CSV" Padding="10,5"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
