<Window x:Class="SystemeCaisse.UI.Views.ManualDiscountSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Type de Remise" Height="480" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F5F7">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="🏷️ Sélectionner le type de remise" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
            
            <UniformGrid Columns="1" Rows="5">
                <Button x:Name="BtnBasketPercent" Content="Remise Panier (%)" Click="BtnClick" Margin="0,5" Padding="15" FontSize="18" Background="#E3F2FD" BorderBrush="#2196F3" Cursor="Hand"/>
                <Button x:Name="BtnBasketFixed" Content="Remise Panier (€)" Click="BtnClick" Margin="0,5" Padding="15" FontSize="18" Background="#E8F5E9" BorderBrush="#4CAF50" Cursor="Hand"/>
                <Button x:Name="BtnItemPercent" Content="Remise Article (%)" Click="BtnClick" Margin="0,5" Padding="15" FontSize="18" Background="#FFF3E0" BorderBrush="#FF9800" Cursor="Hand"/>
                <Button x:Name="BtnItemFixed" Content="Remise Article (€)" Click="BtnClick" Margin="0,5" Padding="15" FontSize="18" Background="#FCE4EC" BorderBrush="#E91E63" Cursor="Hand"/>
                <Button x:Name="BtnPriceOverride" Content="💰 Prix de vente" Click="BtnClick" Margin="0,5" Padding="15" FontSize="18" Background="#EDE7F6" BorderBrush="#7B1FA2" Cursor="Hand" FontWeight="SemiBold"/>
            </UniformGrid>

            <Button Content="Annuler" IsCancel="True" Margin="0,20,0,0" Padding="10" Background="Transparent" BorderThickness="0" Foreground="Gray" FontSize="16"/>
        </StackPanel>
    </Grid>
</Window>
